index 0000000000000000000000000000000000000000..29229928a6bde4c77ec65de9a6cd1e9b9edf41e5
--- /dev/null
+++ b/packages/core/src/media/safe/reconciliation.ts
@@ -0,0 +1,155 @@
+/**
+ * Reconciliation of the staged replacement protocol.
+ *
+ * Every step before publication writes an object first and records it in the
+ * database second, so an interruption can leave an object no record refers to
+ * (a candidate written before its revision row, an original retained before its
+ * record, a temporary file of an unfinished write). Interrupted operations are
+ * ended by the replacement service; this module removes what they left behind.
+ *
+ * It never deletes an object a record still needs: the stable key of a media
+ * item is never listed, revision objects that were ever active, are a source or
+ * belong to an open operation are kept, and recorded originals are kept. Each
+ * deletion re-checks under the same lock that writers hold between writing an
+ * object and recording it.
+ *
+ * Only one writing process is assumed. Work of other processes is protected by
+ * the grace period alone: operations and objects changed within it are left.
+ */
+
+import type { Kysely } from "kysely";
+
+import type { MediaOperation } from "../../database/repositories/media-operations.js";
+import { MediaOperationsRepository } from "../../database/repositories/media-operations.js";
+import type { Database } from "../../database/types.js";
+import type { Storage } from "../../storage/types.js";
+import type { KeyedLock } from "./keyed-lock.js";
+import { isSha256Hex } from "./original-keys.js";
+import type { PrivateOriginalStore } from "./private-originals.js";
+import type { ReplaceResult } from "./replacement-service.js";
+import { MEDIA_REVISIONS_PREFIX } from "./revision-keys.js";
+
+/** Default age before reconciliation touches an open operation or an unreferenced object. */
+export const DEFAULT_RECONCILE_GRACE_MS = 10 * 60 * 1000;
+
+export interface ReconcileOptions {
+	/**
+	 * Operations updated, and objects modified, more recently than this are left
+	 * alone because another process may still be working on them. Defaults to
+	 * {@link DEFAULT_RECONCILE_GRACE_MS}. Pass 0 only when no other process writes.
+	 */
+	graceMs?: number;
+	/** Clock for the grace period. */
+	now?: Date;
+	/** Most open operations handled in one run (default 1000). */
+	limit?: number;
+}
+
+export interface ReconciledOperation {
+	mediaId: string;
+	operationId: string;
+	kind: string;
+	/** Journal state the interrupted operation was found in. */
+	fromState: string;
+	/**
+	 * `published`: completed. `rejected`: refused durably (for example the media
+	 * changed or was deleted). `aborted`: rolled back as `INTERRUPTED`. `pending`:
+	 * a retryable condition left it open. `failed`: an error left it open.
+	 */
+	outcome: "published" | "rejected" | "aborted" | "pending" | "failed";
+	code?: string;
+}
+
+export interface ReconciliationReport {
+	operations: ReconciledOperation[];
+	/** Open operations left alone: running in this process or inside the grace period. */
+	skipped: number;
+	/** False when more open operations remain than one run handles. */
+	complete?: boolean;
+	/** Keys of removed candidate objects in the active storage. */
+	removedCandidateObjects: string[];
+	/** Digests of removed private original objects that no record referenced. */
+	removedOriginals: string[];
+	removedTemporaryFiles: number;
+}
+
+export function reconciledOutcome(
+	operation: MediaOperation,
+	result: ReplaceResult,
+): ReconciledOperation {
+	const base = {
+		mediaId: operation.media_id,
+		operationId: operation.operation_id,
+		kind: operation.kind,
+		fromState: operation.state,
+	};
+	if (result.ok) return { ...base, outcome: "published" };
+	if (!result.receipt) return { ...base, outcome: "pending", code: result.code };
+	return {
+		...base,
+		outcome: result.code === "INTERRUPTED" ? "aborted" : "rejected",
+		code: result.code,
+	};
+}
+
+const HEX = "0123456789abcdef";
+
+async function listRevisionObjects(
+	storage: Storage,
+): Promise<Array<{ key: string; sha256: string; lastModified: Date }>> {
+	const found: Array<{ key: string; sha256: string; lastModified: Date }> = [];
+	// Listed per leading digest character: some adapters list only one directory level,
+	// so a prefix ending in a separator would list nothing.
+	for (const digit of HEX) {
+		let cursor: string | undefined;
+		do {
+			const page = await storage.list({ prefix: `${MEDIA_REVISIONS_PREFIX}${digit}`, cursor });
+			for (const file of page.files) {
+				if (!file.key.startsWith(MEDIA_REVISIONS_PREFIX)) continue;
+				const name = file.key.slice(MEDIA_REVISIONS_PREFIX.length);
+				const sha256 = name.split(".")[0] ?? "";
+				if (isSha256Hex(sha256) && !name.includes("/"))
+					found.push({ key: file.key, sha256, lastModified: file.lastModified });
+			}
+			cursor = page.nextCursor;
+		} while (cursor);
+	}
+	return found;
+}
+
+export async function sweepOrphans(context: {
+	db: Kysely<Database>;
+	storage: Storage;
+	originals: PrivateOriginalStore;
+	withLock: KeyedLock;
+	cutoff: Date;
+	isCandidateInFlight: (sha256: string) => boolean;
+	report: ReconciliationReport;
+}): Promise<void> {
+	const { db, storage, originals, withLock, cutoff, report } = context;
+	const repo = new MediaOperationsRepository(db);
+
+	for (const object of await listRevisionObjects(storage)) {
+		if (!(object.lastModified < cutoff)) continue;
+		const removed = await withLock(`object:${object.key}`, async () => {
+			if (context.isCandidateInFlight(object.sha256)) return false;
+			if (await repo.hasOpenOperationForCandidate(object.sha256)) return false;
+			if (await repo.isRevisionObjectInUse(object.key)) return false;
+			await storage.delete(object.key);
+			return true;
+		});
+		if (removed) report.removedCandidateObjects.push(object.key);
+	}
+
+	for (const original of await originals.list()) {
+		if (!(original.lastModified < cutoff)) continue;
+		const removed = await withLock(`original:${original.sha256}`, async () => {
+			if (await repo.getOriginal(original.sha256)) return false;
+			await originals.discard(original.sha256);
+			return true;
+		});
+		if (removed) report.removedOriginals.push(original.sha256);
+	}
+
+	report.removedTemporaryFiles = await originals.removeTemporaryFiles(cutoff);
+}
