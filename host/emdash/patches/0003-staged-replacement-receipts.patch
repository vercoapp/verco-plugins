index 0000000000000000000000000000000000000000..f3af69d164b56add1341a22dc4508bd7e3786bee
--- /dev/null
+++ b/packages/core/src/media/safe/error-text.ts
@@ -0,0 +1,6 @@
+/** The message of an error and of its `cause` chain, for matching driver-specific wording. */
+export function errorText(error: unknown, depth = 0): string {
+	if (typeof error === "string") return error;
+	if (!(error instanceof Error) || depth > 4) return "";
+	return `${error.message} ${errorText(error.cause, depth + 1)}`.trim();
+}
