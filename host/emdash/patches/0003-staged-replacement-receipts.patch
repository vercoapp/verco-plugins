+					if (property === "transaction")
+						return () => {
+							throw new Error("Transactions are not supported");
+						};
+					const value: unknown = Reflect.get(target, property);
+					return typeof value === "function" ? value.bind(target) : value;
+				},
+			});
+			const service = createMediaReplacementService({
+				db: noTransactions,
+				storage: active,
+				originals: createPrivateOriginalStore(
+					createLocalPrivateStorage({
+						directory: join(root, "private"),
+						publicDirectories: [join(root, "uploads")],
+					}),
+				),
+				validator: createOutputValidator({ decoder: inProcessDecoder }),
+			});
+			expect(await service.replace(request())).toMatchObject({
+				ok: false,
+				code: "TRANSACTIONS_UNSUPPORTED",
+			});
+			expect(sha((await served()).bytes!)).toBe(sha(originalBytes));
+			expect(
+				(
+					await db
+						.selectFrom("media")
+						.select("revision_id")
+						.where("id", "=", mediaId)
+						.executeTakeFirstOrThrow()
+				).revision_id,
+			).toBe(revisionId);
+		});
+	});
+
+	describe("crash and resume", () => {
+		for (const step of STEPS) {
+			it(`an interruption after ${step} resumes with the same operation ID and publishes exactly once`, async () => {
+				const died = build((current) => {
+					if (current === step) throw new Died(step);
+				});
+				await expect(died.replace(request())).rejects.toThrow(Died);
+
+				// A restarted host always serves one complete revision.
+				const during = (await served()).bytes!;
+				expect(sha(during)).toBe(sha(step === "published" ? optimized : originalBytes));
+
+				const service = await restart();
+				const result = await service.replace(request());
+				expect(result).toMatchObject({ ok: true, replayed: step === "published" });
+				expect(sha((await served()).bytes!)).toBe(sha(optimized));
+				expect(await count("_emdash_media_operations")).toBe(1);
+				expect(await count("_emdash_media_originals")).toBe(1);
+				expect(await count("_emdash_media_revisions")).toBe(2);
+				expect(await files("private/media-originals")).toEqual([sha(originalBytes)]);
+				expect(await files("uploads/media-revisions")).toEqual([`${sha(optimized)}.png`]);
+
+				const again = await service.replace(request());
+				expect(again).toEqual({ ...result, replayed: true });
+			});
+		}
+
+		it("keeps the receipt across a restart", async () => {
+			const first = await build().replace(request());
+			const service = await restart();
+			const operation = await service.getOperation(mediaId, "op-1");
+			expect(operation).toMatchObject({
+				state: "published",
+				receipt: first.ok ? first.receipt : null,
+			});
+		});
+
+		it("recovers a candidate object lost between staging and the commit", async () => {
+			const service = build(async (current) => {
+				if (current === "original-retained")
+					await rm(join(root, "uploads", "media-revisions", `${sha(optimized)}.png`));
+			});
+			expect((await service.replace(request())).ok).toBe(true);
+			expect(sha((await served()).bytes!)).toBe(sha(optimized));
+		});
+	});
+
+	describe("repeated and conflicting operation IDs", () => {
+		it("returns the original receipt for an identical repeat without another mutation or backup", async () => {
+			const service = build();
+			const first = await service.replace(request());
+			const objects = await files("uploads/media-revisions");
+			const second = await service.replace(request());
+			expect(second).toEqual({ ...first, replayed: true });
+			expect(await count("_emdash_media_revisions")).toBe(2);
+			expect(await count("_emdash_media_originals")).toBe(1);
+			expect(await files("uploads/media-revisions")).toEqual(objects);
+		});
+
+		it("rejects the same ID with different bytes, expected revision, or without writing anything", async () => {
+			const service = build();
+			await service.replace(request());
+			const other = await solid(64, 48, "#20e040").png().toBuffer();
+			const revisions = await count("_emdash_media_revisions");
+			expect(
+				await service.replace(request({ bytes: other, expectedSha256: undefined })),
+			).toMatchObject({ ok: false, code: "CONFLICTING_OPERATION" });
+			expect(
+				await service.replace(request({ expectedRevisionId: "another-revision" })),
+			).toMatchObject({ ok: false, code: "CONFLICTING_OPERATION" });
+			expect(await count("_emdash_media_revisions")).toBe(revisions);
+			expect(await files("uploads/media-revisions")).toEqual([`${sha(optimized)}.png`]);
+		});
+
+		it("scopes IDs to the media item", async () => {
+			const service = build();
+			await service.replace(request());
+			const second = await new MediaRepository(db).create({
+				filename: "b.png",
+				mimeType: "image/png",
+				size: originalBytes.byteLength,
+				width: 64,
+				height: 48,
+				storageKey: "b.png",
+				contentHash: await computeContentHash(originalBytes),
+				status: "ready",
+			});
+			await active.upload({ key: "b.png", body: originalBytes, contentType: "image/png" });
+			const sourceB = (await service.getSourceRevision(second.id))!;
+			expect(
+				(
+					await service.replace({
+						...request(),
+						mediaId: second.id,
+						expectedRevisionId: sourceB.id,
+					})
+				).ok,
+			).toBe(true);
+			expect(await count("_emdash_media_operations")).toBe(2);
+		});
+
+		it("returns the receipt for an identical repeat and still rejects conflicts after the media is deleted", async () => {
+			const service = build();
+			const first = await service.replace(request());
+			await new MediaRepository(db).delete(mediaId);
+			expect(await service.replace(request())).toEqual({ ...first, replayed: true });
+			expect(
+				await service.replace(request({ bytes: originalBytes, expectedSha256: undefined })),
+			).toMatchObject({ code: "CONFLICTING_OPERATION" });
+			expect(await db.selectFrom("media").select("id").where("id", "=", mediaId).execute()).toEqual(
+				[],
+			);
+		});
+
+		it("validates identifiers", async () => {
+			const service = build();
+			for (const bad of [
+				{ operationId: "" },
+				{ operationId: "has space" },
+				{ operationId: "x".repeat(129) },
+				{ mediaId: "" },
+				{ expectedRevisionId: "" },
+			]) {
