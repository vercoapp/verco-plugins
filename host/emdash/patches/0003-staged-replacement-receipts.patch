new file mode 100644
index 0000000000000000000000000000000000000000..423bbda73b00fd2803b608874898801da64e54a3
--- /dev/null
+++ b/packages/core/src/media/safe/replacement-service.ts
@@ -0,0 +1,500 @@
+/**
+ * Staged same-format image replacement with durable receipts.
+ *
+ * The plugin supplies bytes; the host validates, stages an immutable candidate
+ * object, retains the exact original privately, then publishes by moving the
+ * media row's revision pointer, applying byte-derived metadata and storing the
+ * receipt in one database transaction. That commit is the only publication
+ * point. A storage object and a database cannot share a transaction, so every
+ * earlier step is repeatable and invisible: readers resolve the active
+ * revision's complete object and never see a candidate until the commit.
+ *
+ * Operations are idempotent per media item and operation ID. A repeated
+ * identical request returns the stored outcome (or resumes an interrupted
+ * one); the same ID with different input is refused.
+ *
+ * Not yet enforced: other writers (editor replacement, deletion, native and
+ * bridge access) still change media without advancing a revision, and the
+ * image endpoint, export and native reads still resolve the stable key
+ * directly. Mutation stays disabled until those paths participate.
+ */
+
+import type { Kysely, Transaction } from "kysely";
+import { ulid } from "ulidx";
+
+import type {
+	MediaOperation,
+	MediaRevision,
+} from "../../database/repositories/media-operations.js";
+import {
+	isOpenOperation,
+	MediaOperationsRepository,
+} from "../../database/repositories/media-operations.js";
+import type { Database } from "../../database/types.js";
+import type { Storage } from "../../storage/types.js";
+import { computeContentHash } from "../../utils/hash.js";
+import { sha256Hex } from "./digest.js";
+import { errorText } from "./error-text.js";
+import type { PrivateOriginalStore } from "./private-originals.js";
+import { PrivateOriginalError } from "./private-originals.js";
+import { revisionObjectKey } from "./revision-keys.js";
+import type { OutputRejectionCode } from "./validate-output.js";
+import { createOutputValidator } from "./validate-output.js";
+
+export type ReplacementStep =
+	| "intent-recorded"
+	| "candidate-object-written"
+	| "candidate-staged"
+	| "original-object-retained"
+	| "original-retained"
+	| "publish-prepared"
+	| "published";
+
+export type ReplacementRejectionCode =
+	| OutputRejectionCode
+	| "INVALID_REQUEST"
+	| "CONFLICTING_OPERATION"
+	| "CONFLICT"
+	| "SOURCE_UNREADABLE"
+	| "SOURCE_CHANGED"
+	| "BACKUP_FAILED"
+	| "TRANSACTIONS_UNSUPPORTED";
+
+export interface ReplaceRequest {
+	mediaId: string;
+	operationId: string;
+	/** The revision the caller read; the host publishes only if it is still active. */
+	expectedRevisionId: string;
+	bytes: Uint8Array;
+	/** SHA-256 of the bytes the caller produced. Strongly recommended: see the validator. */
+	expectedSha256?: string;
+	createdBy?: string;
+}
+
+export interface PublishedReceipt {
+	status: "published";
+	operationId: string;
+	kind: "replace";
+	mediaId: string;
+	expectedRevisionId: string;
+	newRevisionId: string;
+	candidateSha256: string;
+	originalSha256: string | null;
+	size: number;
+	width: number;
+	height: number;
+	mimeType: string;
+}
+
+export interface RejectedReceipt {
+	status: "rejected";
+	code: string;
+	operationId: string;
+}
+
+export type ReplaceResult =
+	| { ok: true; receipt: PublishedReceipt; replayed: boolean }
+	| {
+			ok: false;
+			code: ReplacementRejectionCode;
+			message: string;
+			/** True when the operation ID is still usable: the same request may be repeated later. */
+			retryable: boolean;
+			/** Present when the rejection was recorded durably for this operation ID. */
+			receipt?: RejectedReceipt;
+	  };
+
+export interface ReplacementServiceOptions {
+	db: Kysely<Database>;
+	/** The active storage that serves public media. */
+	storage: Storage;
+	originals: PrivateOriginalStore;
+	validator: ReturnType<typeof createOutputValidator>;
+	/** Diagnostic and test seam, called after each step; a throw abandons the operation as a crash would. */
+	onStep?: (
+		step: ReplacementStep,
+		context: { mediaId: string; operationId: string },
+	) => Promise<void> | void;
+}
+
+const IDENTIFIER = /^[A-Za-z0-9._:-]{1,128}$/;
+const TRANSIENT: ReadonlySet<ReplacementRejectionCode> = new Set(["BUSY", "DECODER_UNAVAILABLE"]);
+
+const MESSAGES: Readonly<Record<string, string>> = {
+	INVALID_REQUEST: "The request is not valid.",
+	CONFLICTING_OPERATION: "This operation ID was already used with a different request.",
+	CONFLICT: "The media changed or was deleted since the source revision was read.",
+	SOURCE_UNREADABLE: "The source image could not be read.",
+	SOURCE_CHANGED: "The source image no longer matches its recorded revision.",
+	BACKUP_FAILED: "The original could not be retained, so nothing was published.",
+	TRANSACTIONS_UNSUPPORTED: "This database cannot publish atomically; replacement is unavailable.",
+};
+
+const TRANSACTIONS_UNSUPPORTED_RE = /transactions are not supported/i;
+
+async function readObject(storage: Storage, key: string): Promise<Uint8Array | null> {
+	try {
+		const result = await storage.download(key);
+		return new Uint8Array(await new Response(result.body).arrayBuffer());
+	} catch {
+		return null;
+	}
+}
+
+function isPublishedReceipt(value: object): value is PublishedReceipt {
+	return (
+		Reflect.get(value, "status") === "published" &&
+		typeof Reflect.get(value, "operationId") === "string" &&
+		typeof Reflect.get(value, "newRevisionId") === "string" &&
+		typeof Reflect.get(value, "candidateSha256") === "string"
+	);
+}
+
+function isRejectedReceipt(value: object): value is RejectedReceipt {
+	return (
+		Reflect.get(value, "status") === "rejected" &&
+		typeof Reflect.get(value, "code") === "string" &&
+		typeof Reflect.get(value, "operationId") === "string"
+	);
+}
+
+function parseReceipt(operation: MediaOperation): PublishedReceipt | RejectedReceipt | null {
+	if (!operation.receipt) return null;
+	try {
+		const value: unknown = JSON.parse(operation.receipt);
+		if (typeof value !== "object" || value === null) return null;
+		if (isPublishedReceipt(value) || isRejectedReceipt(value)) return value;
+	} catch {
+		// An unreadable receipt is treated as absent.
+	}
+	return null;
+}
+
+const REJECTION_CODES: readonly ReplacementRejectionCode[] = [
+	"EMPTY",
+	"TOO_LARGE_BYTES",
+	"UNDECODABLE",
+	"UNSUPPORTED_FORMAT",
+	"WRONG_FORMAT",
+	"ANIMATED",
+	"TOO_MANY_PIXELS",
+	"DIMENSIONS_CHANGED",
+	"SOURCE_GEOMETRY_UNKNOWN",
+	"CORRUPT",
+	"DIGEST_MISMATCH",
+	"DECODE_TIMEOUT",
+	"DECODER_CRASHED",
+	"DECODER_UNAVAILABLE",
+	"BUSY",
+	"INVALID_REQUEST",
+	"CONFLICTING_OPERATION",
+	"CONFLICT",
+	"SOURCE_UNREADABLE",
+	"SOURCE_CHANGED",
+	"BACKUP_FAILED",
+	"TRANSACTIONS_UNSUPPORTED",
+];
+
+function isRejectionCode(value: string | null): value is ReplacementRejectionCode {
+	return REJECTION_CODES.some((code) => code === value);
+}
+
+function rejectionCode(value: string | null): ReplacementRejectionCode {
+	return isRejectionCode(value) ? value : "CONFLICT";
+}
+
+export function createMediaReplacementService(options: ReplacementServiceOptions) {
+	const { db, storage, originals, validator } = options;
+	const repo = new MediaOperationsRepository(db);
+
+	async function step(name: ReplacementStep, mediaId: string, operationId: string): Promise<void> {
+		await options.onStep?.(name, { mediaId, operationId });
+	}
+
+	function rejected(code: ReplacementRejectionCode, receipt?: RejectedReceipt): ReplaceResult {
+		return {
+			ok: false,
+			code,
+			message: MESSAGES[code] ?? "The replacement was rejected.",
+			retryable: false,
+			receipt,
+		};
+	}
+
+	async function reject(
+		operation: MediaOperation,
+		code: ReplacementRejectionCode,
+		message?: string,
+	): Promise<ReplaceResult> {
+		const finished = await repo.finishOperation(operation.media_id, operation.operation_id, {
+			state: "rejected",
+			errorCode: code,
+		});
+		// Lost the race to another worker finishing this operation: report its outcome instead.
+		const current =
+			finished ?? (await repo.getOperation(operation.media_id, operation.operation_id));
+		const receipt = current ? parseReceipt(current) : null;
+		if (receipt?.status === "published") return { ok: true, receipt, replayed: true };
+		const result = rejected(code, receipt?.status === "rejected" ? receipt : undefined);
+		return message && !result.ok ? { ...result, message } : result;
+	}
+
+	function replayOf(operation: MediaOperation): ReplaceResult | null {
+		if (isOpenOperation(operation)) return null;
+		const receipt = parseReceipt(operation);
+		if (receipt?.status === "published") return { ok: true, receipt, replayed: true };
+		return rejected(
+			rejectionCode(operation.error_code),
+			receipt?.status === "rejected" ? receipt : undefined,
+		);
+	}
+
+	/** Write the candidate object if absent or damaged; verify it by reading it back. */
+	async function ensureCandidateObject(
+		key: string,
+		bytes: Uint8Array,
+		sha256: string,
+		mimeType: string,
+	): Promise<boolean> {
+		const existing = await readObject(storage, key);
+		if (existing && (await sha256Hex(existing)) === sha256) return false;
+		await storage.upload({ key, body: bytes, contentType: mimeType });
+		const stored = await readObject(storage, key);
+		if (!stored || (await sha256Hex(stored)) !== sha256) {
+			await storage.delete(key).catch(() => undefined);
+			throw new Error("The staged candidate does not match its digest");
+		}
+		return true;
+	}
+
+	async function atomically<T>(work: (trx: Transaction<Database>) => Promise<T>): Promise<T> {
+		try {
+			return await db.transaction().execute(work);
+		} catch (error) {
+			if (TRANSACTIONS_UNSUPPORTED_RE.test(errorText(error)))
+				throw new TransactionsUnsupportedError();
+			throw error;
+		}
+	}
+
+	class TransactionsUnsupportedError extends Error {
+		constructor() {
+			super("Transactions are not supported by this database");
+			this.name = "TransactionsUnsupportedError";
+		}
+	}
+
+	async function replace(request: ReplaceRequest): Promise<ReplaceResult> {
+		try {
+			return await run(request);
+		} catch (error) {
+			// Every durable step needs atomic transitions; refuse rather than run them non-atomically.
+			if (error instanceof TransactionsUnsupportedError)
+				return rejected("TRANSACTIONS_UNSUPPORTED");
+			throw error;
+		}
+	}
+
+	async function run(request: ReplaceRequest): Promise<ReplaceResult> {
+		if (
+			!IDENTIFIER.test(request.operationId) ||
+			!request.mediaId ||
+			request.mediaId.length > 128 ||
+			!request.expectedRevisionId ||
+			!(request.bytes instanceof Uint8Array)
+		) {
+			return rejected("INVALID_REQUEST");
+		}
+		const { mediaId, operationId } = request;
+		const candidateSha256 = await sha256Hex(request.bytes);
+
+		const begun = await repo.beginOperation({
+			mediaId,
+			operationId,
+			kind: "replace",
+			expectedRevisionId: request.expectedRevisionId,
+			candidateSha256,
+			createdBy: request.createdBy,
+		});
+		if (begun.status === "conflict") return rejected("CONFLICTING_OPERATION");
+		const replay = replayOf(begun.operation);
+		if (replay) return replay;
+		let operation = begun.operation;
+		await step("intent-recorded", mediaId, operationId);
+
+		// --- Stage ---
+		let candidate: MediaRevision | null = operation.candidate_revision_id
+			? await repo.getRevision(operation.candidate_revision_id)
+			: null;
+		if (operation.state === "intent") {
+			const source = await repo.getRevision(operation.expected_revision_id);
+			const current = await db
+				.selectFrom("media")
+				.select(["revision_id", "status", "mime_type"])
+				.where("id", "=", mediaId)
+				.executeTakeFirst();
+			if (
+				!source ||
+				source.media_id !== mediaId ||
+				!current ||
+				current.status !== "ready" ||
+				current.revision_id !== source.id
+			) {
+				return reject(operation, "CONFLICT");
+			}
+			const validation = await validator.validate(
+				request.bytes,
+				{ mimeType: source.mime_type, width: source.width, height: source.height },
+				{ expectedSha256: request.expectedSha256 },
+			);
+			if (!validation.ok) {
+				// A transient condition must not consume the operation ID.
+				if (TRANSIENT.has(validation.code))
+					return { ok: false, code: validation.code, message: validation.message, retryable: true };
+				return reject(operation, validation.code, validation.message);
+			}
+			const objectKey = revisionObjectKey(validation.sha256, validation.format);
+			await ensureCandidateObject(objectKey, request.bytes, validation.sha256, validation.mimeType);
+			await step("candidate-object-written", mediaId, operationId);
+			const row = {
+				id: ulid(),
+				media_id: mediaId,
+				kind: "replace",
+				object_key: objectKey,
+				mime_type: validation.mimeType,
+				size: validation.size,
+				width: validation.width,
+				height: validation.height,
+				content_hash: await computeContentHash(request.bytes),
+				sha256: validation.sha256,
+			};
+			const advanced = await atomically(async (trx) => {
+				const transactional = new MediaOperationsRepository(trx);
+				await transactional.insertRevision(row);
+				return transactional.advanceOperation(mediaId, operationId, "intent", {
+					candidateRevisionId: row.id,
+				});
+			});
+			operation = advanced ?? (await repo.getOperation(mediaId, operationId)) ?? operation;
+			candidate = await repo.getRevision(row.id);
+			if (!advanced) return replayOf(operation) ?? rejected("CONFLICT");
+		}
+		await step("candidate-staged", mediaId, operationId);
+		if (!candidate) return reject(operation, "CONFLICT");
+
+		// --- Retain the exact original ---
+		if (operation.state === "candidate_staged") {
+			const source = await repo.getRevision(operation.expected_revision_id);
+			if (!source) return reject(operation, "CONFLICT");
+			const live = await db
+				.selectFrom("media")
+				.select(["revision_id", "status"])
+				.where("id", "=", mediaId)
+				.executeTakeFirst();
+			if (!live || live.status !== "ready" || live.revision_id !== source.id)
+				return reject(operation, "CONFLICT");
+			const original = await readObject(storage, source.object_key);
+			if (!original) return reject(operation, "SOURCE_UNREADABLE");
+			const originalSha256 = await sha256Hex(original);
+			if (source.sha256 !== null && source.sha256 !== originalSha256)
+				return reject(operation, "SOURCE_CHANGED");
+			// A legacy writer may have changed the bytes under the stable key since the baseline was taken.
+			if (
+				source.content_hash !== null &&
+				source.content_hash !== (await computeContentHash(original))
+			)
+				return reject(operation, "SOURCE_CHANGED");
+			let retained;
+			try {
+				retained = await originals.retain(original, source.mime_type);
+			} catch (error) {
+				if (error instanceof PrivateOriginalError) return reject(operation, "BACKUP_FAILED");
+				throw error;
+			}
+			await step("original-object-retained", mediaId, operationId);
+			const advanced = await atomically(async (trx) => {
+				const transactional = new MediaOperationsRepository(trx);
+				if (source.sha256 === null)
+					await transactional.recordRevisionDigest(source.id, retained.sha256);
+				await transactional.recordOriginal({
+					sha256: retained.sha256,
+					storageKey: retained.storageKey,
+					size: retained.size,
+					mimeType: source.mime_type,
+				});
+				return transactional.advanceOperation(mediaId, operationId, "candidate_staged", {
+					originalSha256: retained.sha256,
+				});
+			});
+			operation = advanced ?? (await repo.getOperation(mediaId, operationId)) ?? operation;
+			if (!advanced) return replayOf(operation) ?? rejected("CONFLICT");
+		}
+		await step("original-retained", mediaId, operationId);
+
+		// --- Publish: the single commit point ---
+		if (operation.state === "original_retained") {
+			// The candidate object is verified again at the commit boundary; it may have been lost since staging.
+			try {
+				await ensureCandidateObject(
+					candidate.object_key,
+					request.bytes,
+					candidate.sha256 ?? candidateSha256,
+					candidate.mime_type,
+				);
+			} catch {
+				return rejected("SOURCE_UNREADABLE");
+			}
+			const ready = operation;
+			const receipt: PublishedReceipt = {
+				status: "published",
+				operationId,
+				kind: "replace",
+				mediaId,
+				expectedRevisionId: ready.expected_revision_id,
+				newRevisionId: candidate.id,
+				candidateSha256: ready.candidate_sha256,
+				originalSha256: ready.original_sha256,
+				size: candidate.size ?? request.bytes.byteLength,
+				width: candidate.width ?? 0,
+				height: candidate.height ?? 0,
+				mimeType: candidate.mime_type,
+			};
+			const published = await atomically(async (trx) => {
+				const transactional = new MediaOperationsRepository(trx);
+				const moved = await transactional.movePointer({
+					mediaId,
+					expectedRevisionId: ready.expected_revision_id,
+					candidate,
+				});
+				if (!moved) return false;
+				const done = await transactional.publishOperation(mediaId, operationId, receipt);
+				if (!done) throw new Error("The operation was not in the original_retained state");
+				await step("publish-prepared", mediaId, operationId);
+				return true;
+			});
+			if (!published) return reject(operation, "CONFLICT");
+			await step("published", mediaId, operationId);
+			return { ok: true, receipt, replayed: false };
+		}
+
+		// The operation finished while we were working (another worker, or a retry that overtook us).
+		const final = await repo.getOperation(mediaId, operationId);
+		return (final && replayOf(final)) ?? rejected("CONFLICT");
+	}
+
+	return {
+		replace,
+		/** The revision a caller should pass as `expectedRevisionId`, creating the baseline for unmanaged media. */
+		async getSourceRevision(mediaId: string): Promise<MediaRevision | null> {
+			return repo.ensureActiveRevision(mediaId);
+		},
+		/** Status of an operation, including its durable receipt. */
+		async getOperation(mediaId: string, operationId: string) {
+			const operation = await repo.getOperation(mediaId, operationId);
+			if (!operation) return null;
+			return { state: operation.state, kind: operation.kind, receipt: parseReceipt(operation) };
+		},
+	};
+}
+
+export type MediaReplacementService = ReturnType<typeof createMediaReplacementService>;
