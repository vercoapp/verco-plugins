@@ -0,0 +1,709 @@
+import { createHash } from "node:crypto";
+import { mkdir, mkdtemp, readdir, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { Kysely, SqliteDialect } from "kysely";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { GET } from "../../../../src/astro/routes/api/media/file/[...key].js";
+import { runMigrations } from "../../../../src/database/migrations/runner.js";
+import { MediaRepository } from "../../../../src/database/repositories/media.js";
+import type { Database } from "../../../../src/database/types.js";
+import { openNodeSqliteDatabase } from "../../../../src/db/node-sqlite-compat.js";
+import { createDecodeAdmission } from "../../../../src/media/safe/admission.js";
+import type { FullImageDecoder } from "../../../../src/media/safe/decoder.js";
+import { ImageDecodeError } from "../../../../src/media/safe/decoder.js";
+import { createLocalPrivateStorage } from "../../../../src/media/safe/private-local.js";
+import { createPrivateOriginalStore } from "../../../../src/media/safe/private-originals.js";
+import type { ReplacementStep } from "../../../../src/media/safe/replacement-service.js";
+import { createMediaReplacementService } from "../../../../src/media/safe/replacement-service.js";
+import { createOutputValidator } from "../../../../src/media/safe/validate-output.js";
+import { LocalStorage } from "../../../../src/storage/local.js";
+import type { Storage } from "../../../../src/storage/types.js";
+import { computeContentHash } from "../../../../src/utils/hash.js";
+import { inProcessDecoder, noisy, solid } from "./output-fixtures.js";
+
+const STEPS: ReplacementStep[] = [
+	"intent-recorded",
+	"candidate-object-written",
+	"candidate-staged",
+	"original-object-retained",
+	"original-retained",
+	"publish-prepared",
+	"published",
+];
+const sha = (bytes: Uint8Array) => createHash("sha256").update(bytes).digest("hex");
+const KEY = "01HZSTABLEKEY.png";
+
+class Died extends Error {}
+
+describe("media replacement service", () => {
+	let root: string;
+	let db: Kysely<Database>;
+	let active: LocalStorage;
+	let originalBytes: Uint8Array;
+	let optimized: Uint8Array;
+	let mediaId: string;
+	let revisionId: string;
+	let decoder: FullImageDecoder;
+	let privateFailure: "none" | "write";
+
+	const open = () =>
+		new Kysely<Database>({
+			dialect: new SqliteDialect({ database: openNodeSqliteDatabase(join(root, "site.db")) }),
+		});
+
+	function build(
+		onStep?: (step: ReplacementStep) => Promise<void> | void,
+		admission?: ReturnType<typeof createDecodeAdmission>,
+	) {
+		const privateStorage = createLocalPrivateStorage({
+			directory: join(root, "private"),
+			publicDirectories: [join(root, "uploads")],
+		});
+		const guarded: Storage = {
+			upload: (options) => {
+				if (privateFailure === "write") throw new Error("disk full");
+				return privateStorage.upload(options);
+			},
+			download: (key) => privateStorage.download(key),
+			delete: (key) => privateStorage.delete(key),
+			exists: (key) => privateStorage.exists(key),
+			list: (options) => privateStorage.list(options),
+			getSignedUploadUrl: (options) => privateStorage.getSignedUploadUrl(options),
+			getPublicUrl: (key) => privateStorage.getPublicUrl(key),
+		};
+		return createMediaReplacementService({
+			db,
+			storage: active,
+			originals: createPrivateOriginalStore(guarded),
+			validator: createOutputValidator({
+				decoder: { decode: (bytes, request) => decoder.decode(bytes, request) },
+				admission,
+			}),
+			onStep: onStep ? (step) => onStep(step) : undefined,
+		});
+	}
+
+	/** Simulates a restart: a new connection and service over the same files. */
+	async function restart(onStep?: Parameters<typeof build>[0]) {
+		await db.destroy();
+		db = open();
+		return build(onStep);
+	}
+
+	const request = (extra: Record<string, unknown> = {}) => ({
+		mediaId,
+		operationId: "op-1",
+		expectedRevisionId: revisionId,
+		bytes: optimized,
+		expectedSha256: sha(optimized),
+		...extra,
+	});
+	const served = async (key = KEY) => {
+		const response = await GET({
+			params: { key },
+			locals: { emdash: { storage: active, db } },
+			request: new Request("https://example.com"),
+		} as never);
+		return {
+			status: response.status,
+			bytes: response.status === 200 ? new Uint8Array(await response.arrayBuffer()) : null,
+			type: response.headers.get("Content-Type"),
+		};
+	};
+	const count = async (
+		table: "_emdash_media_revisions" | "_emdash_media_originals" | "_emdash_media_operations",
+	) =>
+		Number(
+			(
+				await db
+					.selectFrom(table)
+					.select((eb) => eb.fn.countAll().as("n"))
+					.executeTakeFirstOrThrow()
+			).n,
+		);
+	const files = async (directory: string) =>
+		(await readdir(join(root, directory)).catch(() => []))
+			.filter((name) => !name.endsWith(".tmp"))
+			.toSorted();
+
+	beforeEach(async () => {
+		root = await mkdtemp(join(tmpdir(), "emdash-replace-"));
+		await mkdir(join(root, "uploads"), { recursive: true });
+		db = open();
+		await runMigrations(db);
+		active = new LocalStorage({
+			directory: join(root, "uploads"),
+			baseUrl: "/_emdash/api/media/file",
+		});
+		decoder = inProcessDecoder;
+		privateFailure = "none";
+		originalBytes = await noisy(64, 48, "png");
+		optimized = await solid(64, 48, "#2060e0").png().toBuffer();
+		await active.upload({ key: KEY, body: originalBytes, contentType: "image/png" });
+		const media = await new MediaRepository(db).create({
+			filename: "photo.png",
+			mimeType: "image/png",
+			size: originalBytes.byteLength,
+			width: 64,
+			height: 48,
+			alt: "Original alt",
+			caption: "Original caption",
+			storageKey: KEY,
+			contentHash: await computeContentHash(originalBytes),
+			status: "ready",
+			authorId: "author-1",
+		});
+		mediaId = media.id;
+		await new MediaRepository(db).update(mediaId, { focalX: 0.25, focalY: 0.75 });
+		await db
+			.updateTable("media")
+			.set({ blurhash: "LEHV6nWB2yk8", dominant_color: "rgb(1,2,3)" })
+			.where("id", "=", mediaId)
+			.execute();
+		revisionId = (await build().getSourceRevision(mediaId))!.id;
+	});
+
+	afterEach(async () => {
+		await db.destroy();
+		await rm(root, { recursive: true, force: true });
+	});
+
+	describe("publication", () => {
+		it("publishes a candidate and keeps identity, URL and editorial metadata", async () => {
+			const before = await db
+				.selectFrom("media")
+				.selectAll()
+				.where("id", "=", mediaId)
+				.executeTakeFirstOrThrow();
+			const result = await build().replace(request());
+			if (!result.ok) throw new Error(JSON.stringify(result));
+			expect(result).toMatchObject({
+				ok: true,
+				replayed: false,
+				receipt: {
+					status: "published",
+					mediaId,
+					expectedRevisionId: revisionId,
+					candidateSha256: sha(optimized),
+					originalSha256: sha(originalBytes),
+					width: 64,
+					height: 48,
+					mimeType: "image/png",
+				},
+			});
+			const after = await db
+				.selectFrom("media")
+				.selectAll()
+				.where("id", "=", mediaId)
+				.executeTakeFirstOrThrow();
+			for (const column of [
+				"id",
+				"filename",
+				"mime_type",
+				"storage_key",
+				"alt",
+				"caption",
+				"focal_x",
+				"focal_y",
+				"folder_id",
+				"author_id",
+				"created_at",
+				"status",
+			] as const) {
+				expect(after[column], column).toEqual(before[column]);
+			}
+			expect(after.revision_id).toBe(result.ok && result.receipt.newRevisionId);
+			expect(after).toMatchObject({
+				size: optimized.byteLength,
+				width: 64,
+				height: 48,
+				content_hash: await computeContentHash(optimized),
+				blurhash: null,
+				dominant_color: null,
+			});
+		});
+
+		it("serves the new bytes at the unchanged stable URL and never exposes revision or original keys", async () => {
+			expect((await served()).bytes).toEqual(new Uint8Array(originalBytes));
+			const result = await build().replace(request());
+			expect(result.ok).toBe(true);
+			const now = await served();
+			expect(now.status).toBe(200);
+			expect(now.type).toBe("image/png");
+			expect(now.bytes).toEqual(new Uint8Array(optimized));
+			expect((await served(`media-revisions/${sha(optimized)}.png`)).status).toBe(404);
+			expect((await served(`media-originals/${sha(originalBytes)}`)).status).toBe(404);
+		});
+
+		it("keeps the superseded object, retains the exact original privately and records both digests", async () => {
+			await build().replace(request());
+			expect(await readFile(join(root, "uploads", KEY))).toEqual(Buffer.from(originalBytes));
+			expect(await files("uploads/media-revisions")).toEqual([`${sha(optimized)}.png`]);
+			expect(await readFile(join(root, "private", "media-originals", sha(originalBytes)))).toEqual(
+				Buffer.from(originalBytes),
+			);
+			const revisions = await db
+				.selectFrom("_emdash_media_revisions")
+				.selectAll()
+				.orderBy("id")
+				.execute();
+			expect(revisions.map((revision) => [revision.kind, revision.sha256])).toEqual([
+				["baseline", sha(originalBytes)],
+				["replace", sha(optimized)],
+			]);
+			expect(await count("_emdash_media_originals")).toBe(1);
+		});
+
+		it("keeps serving the old bytes until the commit, for every interruption before it", async () => {
+			for (const step of STEPS.slice(0, 6)) {
+				const operationId = `op-${step}`;
+				const seen: Array<{ step: string; bytes: Uint8Array | null }> = [];
+				const service = build(async (current) => {
+					// The publish-prepared seam runs inside the transaction, which holds the only connection.
