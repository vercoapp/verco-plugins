@@ -0,0 +1,27 @@
+import type { Kysely } from "kysely";
+
+import { MediaOperationsRepository } from "../../database/repositories/media-operations.js";
+import type { Database } from "../../database/types.js";
+import { errorText } from "./error-text.js";
+
+const MISSING_TABLE = /no such table|does not exist|no such column/i;
+
+/**
+ * Map a media row's stable storage key to the object holding its active
+ * revision. Unmanaged media (and databases without the safe-media tables yet)
+ * resolve to the key itself, so existing media keep serving unchanged.
+ */
+export async function resolveActiveObjectKey(
+	db: Kysely<Database> | undefined,
+	storageKey: string,
+): Promise<string> {
+	if (!db) return storageKey;
+	try {
+		return (await new MediaOperationsRepository(db).findActiveObjectKey(storageKey)) ?? storageKey;
+	} catch (error) {
+		// Before migration 092 has run there is nothing to resolve; any other failure must not
+		// silently serve possibly stale bytes.
+		if (MISSING_TABLE.test(errorText(error))) return storageKey;
+		throw error;
+	}
+}
diff --git a/packages/core/src/media/safe/revision-keys.ts b/packages/core/src/media/safe/revision-keys.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ebb2dfd527aa3eb794cebc6cef26ce4399e30ce3
--- /dev/null
+++ b/packages/core/src/media/safe/revision-keys.ts
@@ -0,0 +1,27 @@
+/**
+ * Storage layout for immutable revision objects.
+ *
+ * Published bytes live under a digest-addressed key in the active storage and
+ * are never overwritten. The media row's stable `storage_key` keeps its public
+ * URL; the file route resolves it to the active revision's object. Clients
+ * must not be able to request these keys directly (a superseded or rejected
+ * candidate would otherwise be fetchable), so the prefix is refused by the
+ * public route like the other private prefixes.
+ */
+
+import type { SafeImageFormat } from "./decode-limits.js";
+import { isSha256Hex } from "./original-keys.js";
+
+export const MEDIA_REVISIONS_PREFIX = "media-revisions/";
+
+const EXTENSION: Readonly<Record<SafeImageFormat, string>> = {
+	jpeg: "jpg",
+	png: "png",
+	webp: "webp",
+};
+
+export function revisionObjectKey(sha256: string, format: SafeImageFormat): string {
+	if (!isSha256Hex(sha256))
+		throw new TypeError("A revision object is addressed by a lowercase hex SHA-256 digest");
+	return `${MEDIA_REVISIONS_PREFIX}${sha256}.${EXTENSION[format]}`;
+}
