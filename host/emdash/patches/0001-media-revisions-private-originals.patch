diff --git a/packages/core/src/media/safe/digest.ts b/packages/core/src/media/safe/digest.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e9ce7fcf48c174c2fc5c0bd39284e261c536e867
--- /dev/null
+++ b/packages/core/src/media/safe/digest.ts
@@ -0,0 +1,9 @@
+/** Lowercase hex SHA-256 of `bytes`, using WebCrypto (available on Node and workerd). */
+export async function sha256Hex(bytes: Uint8Array | ArrayBuffer): Promise<string> {
+	const view = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+	// Copy into a plain ArrayBuffer: a view may sit on a SharedArrayBuffer, which digest() rejects.
+	const copy = new Uint8Array(view.byteLength);
+	copy.set(view);
+	const digest = await crypto.subtle.digest("SHA-256", copy);
+	return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("");
+}
diff --git a/packages/core/src/media/safe/original-keys.ts b/packages/core/src/media/safe/original-keys.ts
new file mode 100644
index 0000000000000000000000000000000000000000..34a8ea4f7b91186dc0229101b31e4fcce43b70ca
--- /dev/null
+++ b/packages/core/src/media/safe/original-keys.ts
@@ -0,0 +1,24 @@
+/**
+ * Storage layout for retained originals.
+ *
+ * Originals are addressed by the SHA-256 of their bytes under a reserved
+ * prefix. They live in private storage that is never mounted publicly, and the
+ * public media route also refuses this prefix (see
+ * {@link PRIVATE_STORAGE_PREFIXES}) so that a misconfiguration which places
+ * them in the active bucket still cannot serve them.
+ */
+
+export const MEDIA_ORIGINALS_PREFIX = "media-originals/";
+
+const SHA256_HEX = /^[0-9a-f]{64}$/;
+
+export function isSha256Hex(value: string): boolean {
+	return SHA256_HEX.test(value);
+}
+
+export function originalStorageKey(sha256: string): string {
+	if (!isSha256Hex(sha256)) {
+		throw new TypeError("An original is addressed by a lowercase hex SHA-256 digest");
+	}
+	return `${MEDIA_ORIGINALS_PREFIX}${sha256}`;
+}
