@@ -0,0 +1,171 @@
+/**
+ * Local-filesystem private storage for retained originals (Node only).
+ *
+ * The first qualified profile keeps originals in a directory that is neither
+ * the active storage directory, nor inside or above it, nor under the Astro
+ * public directory, so no static or storage-adapter route can reach it.
+ * Writes go to a temporary name, are flushed, and are renamed into place with
+ * the parent directory flushed, so a final name never holds a partial object.
+ */
+
+import { createReadStream, realpathSync } from "node:fs";
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import { Readable } from "node:stream";
+
+import type { ListOptions, ListResult, Storage, UploadResult } from "../../storage/types.js";
+import { EmDashStorageError } from "../../storage/types.js";
+
+export class PrivateStorageConfigError extends Error {
+	constructor(message: string) {
+		super(message);
+		this.name = "PrivateStorageConfigError";
+	}
+}
+
+export interface LocalPrivateStorageOptions {
+	/** Directory that will hold retained originals. */
+	directory: string;
+	/** Directories that are publicly reachable or hold public media: the active storage and Astro `public`. */
+	publicDirectories: readonly string[];
+}
+
+/** Resolve through symlinks for the deepest existing ancestor, then append the rest. */
+function resolveReal(target: string): string {
+	let existing = path.resolve(target);
+	const rest: string[] = [];
+	for (;;) {
+		try {
+			return path.join(realpathSync(existing), ...rest.toReversed());
+		} catch {
+			const parent = path.dirname(existing);
+			if (parent === existing) return path.resolve(target);
+			rest.push(path.basename(existing));
+			existing = parent;
+		}
+	}
+}
+
+function contains(parent: string, child: string): boolean {
+	const relative = path.relative(parent, child);
+	return relative === "" || (!relative.startsWith("..") && !path.isAbsolute(relative));
+}
+
+const TEMPORARY_SUFFIX = ".tmp";
+
+class DurableLocalStorage implements Storage {
+	constructor(private readonly directory: string) {}
+
+	private filePath(key: string): string {
+		const resolved = path.resolve(this.directory, key);
+		if (
+			key.length === 0 ||
+			key.includes("\0") ||
+			path.isAbsolute(key) ||
+			!resolved.startsWith(this.directory + path.sep)
+		) {
+			throw new EmDashStorageError("Invalid file path", "INVALID_PATH");
+		}
+		return resolved;
+	}
+
+	async upload(options: {
+		key: string;
+		body: Buffer | Uint8Array | ReadableStream<Uint8Array>;
+	}): Promise<UploadResult> {
+		const target = this.filePath(options.key);
+		const bytes =
+			options.body instanceof ReadableStream
+				? new Uint8Array(await new Response(options.body).arrayBuffer())
+				: options.body;
+		const temporary = `${target}.${crypto.randomUUID()}${TEMPORARY_SUFFIX}`;
+		try {
+			await fs.mkdir(path.dirname(target), { recursive: true });
+			const handle = await fs.open(temporary, "wx", 0o600);
+			try {
+				await handle.writeFile(bytes);
+				await handle.sync();
+			} finally {
+				await handle.close();
+			}
+			await fs.rename(temporary, target);
+			const parent = await fs.open(path.dirname(target), "r");
+			try {
+				await parent.sync();
+			} finally {
+				await parent.close();
+			}
+		} catch (error) {
+			await fs.rm(temporary, { force: true });
+			throw new EmDashStorageError(`Failed to upload file: ${options.key}`, "UPLOAD_FAILED", error);
+		}
+		return { key: options.key, url: "", size: bytes.byteLength };
+	}
+
+	async download(key: string) {
+		const target = this.filePath(key);
+		let size: number;
+		try {
+			size = (await fs.stat(target)).size;
+		} catch {
+			throw new EmDashStorageError(`File not found: ${key}`, "NOT_FOUND");
+		}
+		// eslint-disable-next-line typescript/no-unsafe-type-assertion -- Readable.toWeb returns ReadableStream<unknown>; file streams yield Uint8Array chunks
+		const body = Readable.toWeb(createReadStream(target)) as ReadableStream<Uint8Array>;
+		return { body, contentType: "application/octet-stream", size };
+	}
+
+	async delete(key: string): Promise<void> {
+		await fs.rm(this.filePath(key), { force: true });
+	}
+
+	async exists(key: string): Promise<boolean> {
+		return fs.access(this.filePath(key)).then(
+			() => true,
+			() => false,
+		);
+	}
+
+	async list(options: ListOptions = {}): Promise<ListResult> {
+		const files: ListResult["files"] = [];
+		const walk = async (directory: string): Promise<void> => {
+			for (const entry of await fs.readdir(directory, { withFileTypes: true }).catch(() => [])) {
+				const full = path.join(directory, entry.name);
+				if (entry.isDirectory()) await walk(full);
+				else if (!entry.name.endsWith(TEMPORARY_SUFFIX)) {
+					const key = path.relative(this.directory, full).split(path.sep).join("/");
+					if (key.startsWith(options.prefix ?? "")) {
+						const stat = await fs.stat(full);
+						files.push({ key, size: stat.size, lastModified: stat.mtime });
+					}
+				}
+			}
+		};
+		await walk(this.directory);
+		return { files: files.toSorted((a, b) => a.key.localeCompare(b.key)).slice(0, options.limit) };
+	}
+
+	getSignedUploadUrl(): never {
+		throw new EmDashStorageError("Private original storage has no signed URLs", "NOT_SUPPORTED");
+	}
+
+	getPublicUrl(): never {
+		throw new EmDashStorageError("Private original storage has no public URLs", "NOT_SUPPORTED");
+	}
+}
+
+export function createLocalPrivateStorage(options: LocalPrivateStorageOptions): Storage {
+	if (!options.directory) {
+		throw new PrivateStorageConfigError("A private original directory is required");
+	}
+	const directory = resolveReal(options.directory);
+	for (const publicDirectory of options.publicDirectories) {
+		const resolved = resolveReal(publicDirectory);
+		if (contains(resolved, directory) || contains(directory, resolved)) {
+			throw new PrivateStorageConfigError(
+				"The private original directory must be separate from every public directory",
+			);
+		}
+	}
+	return new DurableLocalStorage(directory);
+}
