+++ b/packages/core/src/media/safe/private-originals.ts
@@ -0,0 +1,114 @@
+/**
+ * Private, digest-addressed storage for byte-exact original images.
+ *
+ * Retention is verified: bytes are written, read back and compared with their
+ * SHA-256 before the caller may record the original as retained. A stored
+ * object that fails verification is never reported as retained.
+ */
+
+import type { Storage } from "../../storage/types.js";
+import { sha256Hex } from "./digest.js";
+import { originalStorageKey } from "./original-keys.js";
+
+export type PrivateOriginalErrorCode =
+	| "ORIGINAL_NOT_FOUND"
+	| "ORIGINAL_VERIFY_FAILED"
+	| "ORIGINAL_STORAGE_ERROR";
+
+export class PrivateOriginalError extends Error {
+	constructor(
+		readonly code: PrivateOriginalErrorCode,
+		message: string,
+		options?: { cause?: unknown },
+	) {
+		super(message, options);
+		this.name = "PrivateOriginalError";
+	}
+}
+
+export interface RetainedOriginal {
+	sha256: string;
+	storageKey: string;
+	size: number;
+	/** False when an identical verified original was already retained. */
+	created: boolean;
+}
+
+export interface PrivateOriginalStore {
+	/** Durably retain `bytes` and return only once the stored copy matches its digest. */
+	retain(bytes: Uint8Array, mimeType: string): Promise<RetainedOriginal>;
+	/** Read an original and verify it against `sha256`. */
+	read(sha256: string): Promise<Uint8Array>;
+	exists(sha256: string): Promise<boolean>;
+}
+
+function isNotFound(error: unknown): boolean {
+	if (!(error instanceof Error)) return false;
+	const code = Reflect.get(error, "code");
+	return (
+		code === "NOT_FOUND" ||
+		error.message.includes("not found") ||
+		error.message.includes("NOT_FOUND")
+	);
+}
+
+async function readAll(storage: Storage, key: string): Promise<Uint8Array | null> {
+	try {
+		const result = await storage.download(key);
+		return new Uint8Array(await new Response(result.body).arrayBuffer());
+	} catch (error) {
+		if (isNotFound(error)) return null;
+		throw new PrivateOriginalError("ORIGINAL_STORAGE_ERROR", "Original storage could not be read", {
+			cause: error,
+		});
+	}
+}
+
+export function createPrivateOriginalStore(storage: Storage): PrivateOriginalStore {
+	return {
+		async retain(bytes, mimeType) {
+			const sha256 = await sha256Hex(bytes);
+			const storageKey = originalStorageKey(sha256);
+
+			const existing = await readAll(storage, storageKey);
+			if (existing && (await sha256Hex(existing)) === sha256) {
+				return { sha256, storageKey, size: existing.byteLength, created: false };
+			}
+
+			try {
+				// A missing or corrupt object under this digest is replaced: the key is content-addressed.
+				await storage.upload({ key: storageKey, body: bytes, contentType: mimeType });
+			} catch (error) {
+				throw new PrivateOriginalError("ORIGINAL_STORAGE_ERROR", "Original could not be written", {
+					cause: error,
+				});
+			}
+
+			const stored = await readAll(storage, storageKey);
+			if (!stored || (await sha256Hex(stored)) !== sha256) {
+				await storage.delete(storageKey).catch(() => undefined);
+				throw new PrivateOriginalError(
+					"ORIGINAL_VERIFY_FAILED",
+					"The stored original does not match its digest",
+				);
+			}
+			return { sha256, storageKey, size: stored.byteLength, created: true };
+		},
+
+		async read(sha256) {
+			const bytes = await readAll(storage, originalStorageKey(sha256));
+			if (!bytes) throw new PrivateOriginalError("ORIGINAL_NOT_FOUND", "Original is not retained");
+			if ((await sha256Hex(bytes)) !== sha256) {
+				throw new PrivateOriginalError(
+					"ORIGINAL_VERIFY_FAILED",
+					"The stored original does not match its digest",
+				);
+			}
+			return bytes;
+		},
+
+		async exists(sha256) {
+			return storage.exists(originalStorageKey(sha256));
+		},
+	};
+}
