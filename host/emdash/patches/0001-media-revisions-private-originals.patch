+			.insertInto("media")
+			.values({
+				id: "legacy",
+				filename: "legacy.png",
+				mime_type: "image/png",
+				size: 10,
+				width: 1,
+				height: 1,
+				alt: "Alt",
+				caption: null,
+				storage_key: "legacy.png",
+				status: "ready",
+				content_hash: null,
+				blurhash: null,
+				dominant_color: null,
+				author_id: null,
+				focal_x: null,
+				focal_y: null,
+			} as never)
+			.execute();
+
+		await up(db as Kysely<unknown>);
+		await up(db as Kysely<unknown>);
+
+		const row = await db
+			.selectFrom("media")
+			.select(["id", "alt", "revision_id"])
+			.where("id", "=", "legacy")
+			.executeTakeFirstOrThrow();
+		expect(row).toEqual({ id: "legacy", alt: "Alt", revision_id: null });
+		expect(await db.selectFrom("_emdash_media_revisions").select("id").execute()).toEqual([]);
+	});
+
+	it("keeps operation records without depending on the media row", async () => {
+		await db
+			.insertInto("_emdash_media_operations")
+			.values({
+				media_id: "gone",
+				operation_id: "op",
+				kind: "replace",
+				state: "intent",
+				fingerprint: "f",
+				expected_revision_id: "r",
+				candidate_sha256: "c".repeat(64),
+				candidate_revision_id: null,
+				original_sha256: null,
+				receipt: null,
+				error_code: null,
+				created_by: null,
+				completed_at: null,
+			})
+			.execute();
+		await expect(
+			db
+				.insertInto("_emdash_media_operations")
+				.values({
+					media_id: "gone",
+					operation_id: "op",
+					kind: "replace",
+					state: "intent",
+					fingerprint: "f",
+					expected_revision_id: "r",
+					candidate_sha256: "c".repeat(64),
+					candidate_revision_id: null,
+					original_sha256: null,
+					receipt: null,
+					error_code: null,
+					created_by: null,
+					completed_at: null,
+				})
+				.execute(),
+		).rejects.toThrow();
+	});
+
+	it("down removes only what up added", async () => {
+		await down(db as Kysely<unknown>);
+		const names = await tables(db);
