+
+const DIGEST_A = "a".repeat(64);
+const DIGEST_B = "b".repeat(64);
+
+async function readyMedia(db: Kysely<Database>, storageKey = "photo.png") {
+	const media = new MediaRepository(db);
+	const created = await media.create({
+		filename: storageKey,
+		mimeType: "image/png",
+		size: 120,
+		width: 16,
+		height: 16,
+		storageKey,
+		contentHash: "sha1:legacy",
+		status: "ready",
+	});
+	return created;
+}
+
+describe("MediaOperationsRepository revisions", () => {
+	let db: Kysely<Database>;
+	let repo: MediaOperationsRepository;
+
+	beforeEach(async () => {
+		db = await setupTestDatabase();
+		repo = new MediaOperationsRepository(db);
+	});
+
+	afterEach(async () => {
+		await teardownTestDatabase(db);
+	});
+
+	it("creates a baseline revision from the current row and keeps it stable", async () => {
+		const media = await readyMedia(db);
+		const first = await repo.ensureActiveRevision(media.id);
+		expect(first).toMatchObject({
+			media_id: media.id,
+			kind: "baseline",
+			object_key: "photo.png",
+			mime_type: "image/png",
+			size: 120,
+			width: 16,
+			height: 16,
+			content_hash: "sha1:legacy",
+			sha256: null,
+		});
+		const again = await repo.ensureActiveRevision(media.id);
+		expect(again?.id).toBe(first?.id);
+		const row = await db
+			.selectFrom("media")
+			.select("revision_id")
+			.where("id", "=", media.id)
+			.executeTakeFirst();
+		expect(row?.revision_id).toBe(first?.id);
+	});
+
+	it("returns null for missing and not-ready media and writes nothing", async () => {
+		const media = new MediaRepository(db);
+		const pending = await media.createPending({
+			filename: "p.png",
+			mimeType: "image/png",
+			storageKey: "p.png",
+		});
+		expect(await repo.ensureActiveRevision("missing")).toBeNull();
+		expect(await repo.ensureActiveRevision(pending.id)).toBeNull();
+		expect(await db.selectFrom("_emdash_media_revisions").select("id").execute()).toEqual([]);
+	});
+
+	it("creates exactly one baseline when callers race", async () => {
+		const media = await readyMedia(db);
+		const results = await Promise.all(
+			Array.from({ length: 8 }, () => repo.ensureActiveRevision(media.id)),
+		);
+		expect(new Set(results.map((revision) => revision?.id)).size).toBe(1);
+		const rows = await db.selectFrom("_emdash_media_revisions").select("id").execute();
+		expect(rows).toHaveLength(1);
+	});
+
+	it("records a digest once and rejects a different one", async () => {
+		const media = await readyMedia(db);
+		const revision = (await repo.ensureActiveRevision(media.id))!;
+		await repo.recordRevisionDigest(revision.id, DIGEST_A);
+		await repo.recordRevisionDigest(revision.id, DIGEST_A);
+		await expect(repo.recordRevisionDigest(revision.id, DIGEST_B)).rejects.toThrow(
+			/different digest/,
+		);
+		await expect(repo.recordRevisionDigest(revision.id, "NOT-HEX")).rejects.toThrow(TypeError);
+		expect((await repo.getRevision(revision.id))?.sha256).toBe(DIGEST_A);
+	});
+
+	it("keeps revisions after the media row is deleted", async () => {
+		const media = await readyMedia(db);
+		const revision = (await repo.ensureActiveRevision(media.id))!;
+		await new MediaRepository(db).delete(media.id);
+		expect((await repo.getRevision(revision.id))?.media_id).toBe(media.id);
+	});
+});
+
+describe("MediaOperationsRepository originals", () => {
+	let db: Kysely<Database>;
+	let repo: MediaOperationsRepository;
+
+	beforeEach(async () => {
+		db = await setupTestDatabase();
+		repo = new MediaOperationsRepository(db);
+	});
+
+	afterEach(async () => {
+		await teardownTestDatabase(db);
+	});
+
+	it("records an original once and never duplicates a backup", async () => {
+		const input = {
+			sha256: DIGEST_A,
+			storageKey: `media-originals/${DIGEST_A}`,
+			size: 100,
+			mimeType: "image/png",
+		};
+		expect((await repo.recordOriginal(input)).created).toBe(true);
+		expect((await repo.recordOriginal(input)).created).toBe(false);
+		await repo.recordOriginal({
+			...input,
+			sha256: DIGEST_B,
+			storageKey: `media-originals/${DIGEST_B}`,
+			size: 50,
+		});
+		expect(await repo.backupTotals()).toEqual({ count: 2, bytes: 150 });
+	});
+
+	it("reports zero totals when nothing is retained", async () => {
+		expect(await repo.backupTotals()).toEqual({ count: 0, bytes: 0 });
+	});
+});
+
+describe("MediaOperationsRepository journal", () => {
+	let db: Kysely<Database>;
+	let repo: MediaOperationsRepository;
+	const base = {
+		mediaId: "m1",
+		operationId: "op-1",
+		kind: "replace" as const,
+		expectedRevisionId: "r1",
+		candidateSha256: DIGEST_A,
+	};
+
+	beforeEach(async () => {
+		db = await setupTestDatabase();
+		repo = new MediaOperationsRepository(db);
+	});
+
+	afterEach(async () => {
+		await teardownTestDatabase(db);
+	});
+
+	it("creates an intent, returns the same operation for an identical repeat and rejects conflicting reuse", async () => {
+		const created = await repo.beginOperation(base);
+		expect(created.status).toBe("created");
+		expect(await repo.beginOperation(base)).toMatchObject({
+			status: "existing",
+			operation: { operation_id: "op-1", state: "intent" },
+		});
+		expect((await repo.beginOperation({ ...base, candidateSha256: DIGEST_B })).status).toBe(
+			"conflict",
+		);
+		expect((await repo.beginOperation({ ...base, expectedRevisionId: "r2" })).status).toBe(
+			"conflict",
+		);
+		expect((await repo.beginOperation({ ...base, kind: "restore" })).status).toBe("conflict");
+		expect(
+			(await repo.beginOperation({ ...base, operationId: "op-2", candidateSha256: DIGEST_B }))
+				.status,
+		).toBe("created");
+		expect(
+			await db.selectFrom("_emdash_media_operations").select("operation_id").execute(),
+		).toHaveLength(2);
+	});
+
+	it("scopes operation IDs to the media item", async () => {
+		expect((await repo.beginOperation(base)).status).toBe("created");
+		expect(
+			(await repo.beginOperation({ ...base, mediaId: "m2", candidateSha256: DIGEST_B })).status,
+		).toBe("created");
+	});
+
+	it("exactly one of several concurrent identical begins creates the operation", async () => {
+		const results = await Promise.all(Array.from({ length: 6 }, () => repo.beginOperation(base)));
+		expect(results.filter((result) => result.status === "created")).toHaveLength(1);
+		expect(results.filter((result) => result.status === "existing")).toHaveLength(5);
+	});
+
+	it("advances through states only in order and only from the expected state", async () => {
+		await repo.beginOperation(base);
+		const staged = await repo.advanceOperation("m1", "op-1", "intent", {
+			candidateRevisionId: "c1",
+		});
+		expect(staged).toMatchObject({ state: "candidate_staged", candidate_revision_id: "c1" });
+		expect(await repo.advanceOperation("m1", "op-1", "intent")).toBeNull();
+		const retained = await repo.advanceOperation("m1", "op-1", "candidate_staged", {
+			originalSha256: DIGEST_B,
+		});
+		expect(retained).toMatchObject({ state: "original_retained", original_sha256: DIGEST_B });
+		await expect(repo.advanceOperation("m1", "op-1", "original_retained")).rejects.toThrow(
+			/publication/,
+		);
+	});
+
+	it("durably ends an open operation and never overwrites a terminal one", async () => {
+		await repo.beginOperation(base);
+		const rejected = await repo.finishOperation("m1", "op-1", {
+			state: "rejected",
+			errorCode: "CONFLICT",
+		});
+		expect(rejected).toMatchObject({ state: "rejected", error_code: "CONFLICT" });
+		expect(JSON.parse(rejected!.receipt!)).toMatchObject({ status: "rejected", code: "CONFLICT" });
+		expect(
+			await repo.finishOperation("m1", "op-1", { state: "aborted", errorCode: "INTERRUPTED" }),
+		).toBeNull();
+		expect(await repo.advanceOperation("m1", "op-1", "intent")).toBeNull();
+		expect((await repo.getOperation("m1", "op-1"))?.state).toBe("rejected");
+		expect((await repo.beginOperation(base)).status).toBe("existing");
+	});
+
+	it("lists only open operations", async () => {
+		await repo.beginOperation(base);
+		await repo.beginOperation({ ...base, operationId: "op-2" });
+		await repo.finishOperation("m1", "op-2", { state: "aborted", errorCode: "INTERRUPTED" });
+		expect((await repo.listOpenOperations()).map((operation) => operation.operation_id)).toEqual([
+			"op-1",
+		]);
+	});
+
+	it("keeps conflicting reuse rejected after the media item is deleted", async () => {
+		const media = await readyMedia(db);
+		const revision = (await repo.ensureActiveRevision(media.id))!;
+		const request = { ...base, mediaId: media.id, expectedRevisionId: revision.id };
+		await repo.beginOperation(request);
+		await new MediaRepository(db).delete(media.id);
+		expect((await repo.beginOperation({ ...request, candidateSha256: DIGEST_B })).status).toBe(
+			"conflict",
+		);
+		expect((await repo.beginOperation(request)).status).toBe("existing");
+	});
+
+	it("derives a stable fingerprint from the request fields only", async () => {
+		const a = await operationFingerprint(base);
+		expect(a).toMatch(/^[0-9a-f]{64}$/);
+		expect(await operationFingerprint({ ...base })).toBe(a);
+		expect(await operationFingerprint({ ...base, mediaId: "m2" })).not.toBe(a);
+	});
+});
+
+describe("media operation records survive a restart", () => {
+	let directory: string;
+	const open = (): Kysely<Database> =>
+		new Kysely<Database>({
+			dialect: new SqliteDialect({ database: openNodeSqliteDatabase(join(directory, "site.db")) }),
+		});
+
+	beforeEach(async () => {
+		directory = await mkdtemp(join(tmpdir(), "emdash-media-ops-"));
+	});
+
+	afterEach(async () => {
+		await rm(directory, { recursive: true, force: true });
+	});
+
+	it("keeps revisions, originals and in-flight operations across a new connection", async () => {
+		const first = open();
+		await runMigrations(first);
+		const media = await readyMedia(first);
+		const repo = new MediaOperationsRepository(first);
+		const revision = (await repo.ensureActiveRevision(media.id))!;
+		await repo.recordRevisionDigest(revision.id, DIGEST_A);
+		await repo.recordOriginal({
+			sha256: DIGEST_A,
+			storageKey: `media-originals/${DIGEST_A}`,
+			size: 120,
+			mimeType: "image/png",
+		});
+		await repo.beginOperation({
+			mediaId: media.id,
+			operationId: "op-1",
+			kind: "replace",
+			expectedRevisionId: revision.id,
+			candidateSha256: DIGEST_B,
+		});
+		await repo.advanceOperation(media.id, "op-1", "intent", { candidateRevisionId: "candidate" });
+		await first.destroy();
+
+		const second = open();
+		await runMigrations(second); // restart runs migrations again; nothing is lost or duplicated
+		const restarted = new MediaOperationsRepository(second);
+		expect((await restarted.ensureActiveRevision(media.id))?.id).toBe(revision.id);
+		expect((await restarted.getRevision(revision.id))?.sha256).toBe(DIGEST_A);
+		expect((await restarted.getOriginal(DIGEST_A))?.size).toBe(120);
+		expect(await restarted.listOpenOperations()).toMatchObject([
+			{ operation_id: "op-1", state: "candidate_staged", candidate_revision_id: "candidate" },
+		]);
+		expect(
+			(
+				await restarted.beginOperation({
+					mediaId: media.id,
+					operationId: "op-1",
+					kind: "replace",
+					expectedRevisionId: revision.id,
+					candidateSha256: DIGEST_B,
+				})
+			).status,
+		).toBe("existing");
+		await second.destroy();
+	});
+});
diff --git a/packages/core/tests/unit/media/safe/private-originals-exposure.test.ts b/packages/core/tests/unit/media/safe/private-originals-exposure.test.ts
