+++ b/packages/core/tests/unit/media/safe/private-originals-exposure.test.ts
@@ -0,0 +1,99 @@
+import { mkdir, mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { GET } from "../../../../src/astro/routes/api/media/file/[...key].js";
+import { matchInternalMediaKey } from "../../../../src/media/image-endpoint.js";
+import { originalStorageKey } from "../../../../src/media/safe/original-keys.js";
+import { createLocalPrivateStorage } from "../../../../src/media/safe/private-local.js";
+import { createPrivateOriginalStore } from "../../../../src/media/safe/private-originals.js";
+import { LocalStorage } from "../../../../src/storage/local.js";
+import { isRefusedStorageKey } from "../../../../src/transfer/staging/keys.js";
+
+const bytes = new TextEncoder().encode("a private original that must never be served");
+
+describe("retained originals are not reachable through public delivery", () => {
+	let root: string;
+	let active: LocalStorage;
+	let digest: string;
+	let key: string;
+
+	beforeEach(async () => {
+		root = await mkdtemp(join(tmpdir(), "emdash-exposure-"));
+		await mkdir(join(root, "uploads"), { recursive: true });
+		active = new LocalStorage({
+			directory: join(root, "uploads"),
+			baseUrl: "/_emdash/api/media/file",
+		});
+		const privateStorage = createLocalPrivateStorage({
+			directory: join(root, "private"),
+			publicDirectories: [join(root, "uploads")],
+		});
+		const retained = await createPrivateOriginalStore(privateStorage).retain(bytes, "image/png");
+		digest = retained.sha256;
+		key = retained.storageKey;
+		await active.upload({
+			key: "ordinary.png",
+			body: new Uint8Array([1, 2, 3]),
+			contentType: "image/png",
+		});
+	});
+
+	afterEach(async () => {
+		await rm(root, { recursive: true, force: true });
+	});
+
+	const request = (candidate: string) =>
+		GET({
+			params: { key: candidate },
+			locals: { emdash: { storage: active } },
+			request: new Request("https://example.com"),
+		} as never);
+
+	it("serves ordinary media from the active storage", async () => {
+		expect((await request("ordinary.png")).status).toBe(200);
+	});
+
+	it.each([
+		() => key,
+		() => key.toUpperCase(),
+		() => encodeURIComponent(key),
+		() => encodeURIComponent(encodeURIComponent(key)),
+		() => `./${key}`,
+		() => `x/../${key}`,
+		() => `/${key}`,
+		() => digest,
+		() => `media-originals/${digest}.png`,
+	])(
+		"answers 404 for the retained original under every spelling of its key (%#)",
+		async (spell) => {
+			const response = await request(spell());
+			expect(response.status).toBe(404);
+			expect(await response.text()).not.toContain("private original");
+		},
+	);
+
+	it("refuses the originals prefix even if the active storage holds an object there", async () => {
+		await active.upload({ key, body: bytes, contentType: "image/png" });
+		expect((await request(key)).status).toBe(404);
+		expect(isRefusedStorageKey(key)).toBe(true);
+		expect(isRefusedStorageKey(`MEDIA-ORIGINALS/${digest}`)).toBe(true);
+	});
+
+	it("is not matched as a transformable media key by the image endpoint", () => {
+		for (const href of [
+			`/_emdash/api/media/file/${key}`,
+			`https://site.example/_emdash/api/media/file/${encodeURIComponent(key)}`,
+		]) {
+			expect(matchInternalMediaKey(href)).toBeNull();
+		}
+	});
+
+	it("has no object in the active storage for the original's digest", async () => {
+		expect(await active.exists(digest)).toBe(false);
+		expect(await active.exists(originalStorageKey(digest))).toBe(false);
+		expect((await active.list()).files.map((file) => file.key)).toEqual(["ordinary.png"]);
+	});
+});
diff --git a/packages/core/tests/unit/media/safe/private-originals.test.ts b/packages/core/tests/unit/media/safe/private-originals.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d839c00501f3488dea5ae83054ffed3e6eaac991
--- /dev/null
+++ b/packages/core/tests/unit/media/safe/private-originals.test.ts
@@ -0,0 +1,184 @@
+import { createHash } from "node:crypto";
+import { mkdir, mkdtemp, readdir, readFile, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { originalStorageKey } from "../../../../src/media/safe/original-keys.js";
+import {
+	createLocalPrivateStorage,
+	PrivateStorageConfigError,
+} from "../../../../src/media/safe/private-local.js";
+import { createPrivateOriginalStore } from "../../../../src/media/safe/private-originals.js";
+import type { Storage } from "../../../../src/storage/types.js";
+
+const sha = (bytes: Uint8Array) => createHash("sha256").update(bytes).digest("hex");
+const bytes = new TextEncoder().encode("exact original bytes \u0000ÿ");
+
+describe("private original storage on the local filesystem", () => {
+	let root: string;
+	let publicDirectory: string;
+	let privateDirectory: string;
+	let storage: Storage;
+
+	beforeEach(async () => {
+		root = await mkdtemp(join(tmpdir(), "emdash-private-"));
+		publicDirectory = join(root, "uploads");
+		privateDirectory = join(root, "private");
+		await mkdir(publicDirectory, { recursive: true });
+		storage = createLocalPrivateStorage({
+			directory: privateDirectory,
+			publicDirectories: [publicDirectory],
+		});
+	});
+
+	afterEach(async () => {
+		await rm(root, { recursive: true, force: true });
+	});
+
+	it("retains verified bytes under a digest-addressed key and reads them back", async () => {
+		const store = createPrivateOriginalStore(storage);
+		const retained = await store.retain(bytes, "image/png");
+		expect(retained).toEqual({
+			sha256: sha(bytes),
+			storageKey: originalStorageKey(sha(bytes)),
+			size: bytes.byteLength,
+			created: true,
+		});
+		expect(await readFile(join(privateDirectory, retained.storageKey))).toEqual(Buffer.from(bytes));
+		expect(await store.read(retained.sha256)).toEqual(bytes);
+		expect(await store.exists(retained.sha256)).toBe(true);
+		expect(await store.exists("0".repeat(64))).toBe(false);
+	});
+
+	it("does not duplicate an identical original", async () => {
+		const store = createPrivateOriginalStore(storage);
+		await store.retain(bytes, "image/png");
+		expect((await store.retain(bytes, "image/png")).created).toBe(false);
+		expect((await storage.list()).files).toHaveLength(1);
+	});
+
+	it("replaces a corrupt object that holds the digest's name", async () => {
+		const store = createPrivateOriginalStore(storage);
+		const key = originalStorageKey(sha(bytes));
+		await mkdir(join(privateDirectory, "media-originals"), { recursive: true });
+		await writeFile(join(privateDirectory, key), "half-written");
+		await expect(store.read(sha(bytes))).rejects.toMatchObject({ code: "ORIGINAL_VERIFY_FAILED" });
+		expect((await store.retain(bytes, "image/png")).created).toBe(true);
+		expect(await store.read(sha(bytes))).toEqual(bytes);
+	});
+
+	it("reports a missing original", async () => {
+		await expect(createPrivateOriginalStore(storage).read("1".repeat(64))).rejects.toMatchObject({
+			code: "ORIGINAL_NOT_FOUND",
+		});
+	});
+
+	it("leaves no temporary file and no partial object when a write fails", async () => {
+		const failing: Storage = {
+			...storage,
+			upload: (options) =>
+				storage.upload({
+					...options,
+					body: new ReadableStream({
+						start: (controller) => controller.error(new Error("disk full")),
+					}),
+				}),
+		};
+		await expect(
+			createPrivateOriginalStore(failing).retain(bytes, "image/png"),
+		).rejects.toMatchObject({ code: "ORIGINAL_STORAGE_ERROR" });
+		const names = await readdir(join(privateDirectory, "media-originals")).catch(() => []);
+		expect(names).toEqual([]);
+	});
+
+	it("never offers public or signed URLs", () => {
+		expect(() => storage.getPublicUrl("media-originals/x")).toThrow(/no public URLs/);
+		expect(() => storage.getSignedUploadUrl({ key: "k", contentType: "image/png" })).toThrow(
+			/no signed URLs/,
+		);
+	});
+
+	it("refuses keys that escape the directory", async () => {
+		await expect(storage.download("../uploads/secret")).rejects.toThrow();
+		await expect(
+			storage.upload({ key: "/etc/x", body: bytes, contentType: "image/png" }),
+		).rejects.toThrow();
+		await expect(storage.exists("a/../../x")).rejects.toThrow();
+	});
+
+	it("rejects directories that overlap a public directory, including through a symlink", async () => {
+		const reject = (directory: string) => () =>
+			createLocalPrivateStorage({ directory, publicDirectories: [publicDirectory] });
+		expect(reject(publicDirectory)).toThrow(PrivateStorageConfigError);
+		expect(reject(join(publicDirectory, "private"))).toThrow(PrivateStorageConfigError);
+		expect(reject(root)).toThrow(PrivateStorageConfigError);
+		const link = join(root, "alias");
+		await symlink(publicDirectory, link);
+		expect(reject(join(link, "hidden"))).toThrow(PrivateStorageConfigError);
+		expect(reject("")).toThrow(PrivateStorageConfigError);
+		expect(reject(join(root, "elsewhere"))).not.toThrow();
+	});
+});
+
+describe("private original verification", () => {
+	function memory(tamper: (bytes: Uint8Array) => Uint8Array): Storage & { deleted: string[] } {
+		const objects = new Map<string, Uint8Array>();
+		const deleted: string[] = [];
+		const notFound = () => Object.assign(new Error("File not found"), { code: "NOT_FOUND" });
+		return {
+			deleted,
+			async upload({ key, body }) {
+				const data =
+					body instanceof ReadableStream
+						? new Uint8Array(await new Response(body).arrayBuffer())
+						: body;
+				objects.set(key, tamper(new Uint8Array(data)));
+				return { key, url: "", size: data.byteLength };
+			},
+			async download(key) {
+				const data = objects.get(key);
+				if (!data) throw notFound();
+				return {
+					body: new Blob([data]).stream(),
+					contentType: "application/octet-stream",
+					size: data.byteLength,
+				};
+			},
+			async delete(key) {
+				deleted.push(key);
+				objects.delete(key);
+			},
+			async exists(key) {
+				return objects.has(key);
+			},
+			async list() {
+				return { files: [] };
+			},
+			getSignedUploadUrl() {
+				throw new Error("none");
+			},
+			getPublicUrl() {
+				throw new Error("none");
+			},
+		};
+	}
+
+	it("removes and rejects an object whose stored bytes differ from its digest", async () => {
+		const storage = memory((data) => {
+			data[data.length - 1] ^= 1;
+			return data;
+		});
+		await expect(
+			createPrivateOriginalStore(storage).retain(bytes, "image/png"),
+		).rejects.toMatchObject({ code: "ORIGINAL_VERIFY_FAILED" });
+		expect(storage.deleted).toEqual([originalStorageKey(sha(bytes))]);
+		expect(await storage.exists(originalStorageKey(sha(bytes)))).toBe(false);
+	});
+
+	it("rejects a digest that is not lowercase hex", () => {
+		expect(() => originalStorageKey("../etc/passwd")).toThrow(TypeError);
+		expect(() => originalStorageKey("A".repeat(64))).toThrow(TypeError);
+	});
+});
