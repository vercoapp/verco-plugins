diff --git a/packages/core/src/database/repositories/media-operations.ts b/packages/core/src/database/repositories/media-operations.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9951430919ee8c9aea06bca85f4898f342a27d03
--- /dev/null
+++ b/packages/core/src/database/repositories/media-operations.ts
@@ -0,0 +1,328 @@
+import type { Kysely, Selectable } from "kysely";
+import { ulid } from "ulidx";
+
+import { sha256Hex } from "../../media/safe/digest.js";
+import { isSha256Hex } from "../../media/safe/original-keys.js";
+import type {
+	Database,
+	MediaOperationTable,
+	MediaOriginalTable,
+	MediaRevisionTable,
+} from "../types.js";
+
+export type MediaRevision = Selectable<MediaRevisionTable>;
+export type MediaOriginal = Selectable<MediaOriginalTable>;
+export type MediaOperation = Selectable<MediaOperationTable>;
+
+export type MediaOperationKind = "replace" | "restore";
+
+/**
+ * Journal states. `published` is deliberately absent from the transitions this
+ * repository offers: publication must move the media pointer and the journal
+ * together and is added with the fenced publication step.
+ */
+export const OPEN_OPERATION_STATES = ["intent", "candidate_staged", "original_retained"] as const;
+export type OpenMediaOperationState = (typeof OPEN_OPERATION_STATES)[number];
+export type MediaOperationState = OpenMediaOperationState | "published" | "rejected" | "aborted";
+
+const NEXT_STATE: Readonly<Record<OpenMediaOperationState, MediaOperationState | undefined>> = {
+	intent: "candidate_staged",
+	candidate_staged: "original_retained",
+	original_retained: undefined,
+};
+
+export interface BeginOperationInput {
+	mediaId: string;
+	operationId: string;
+	kind: MediaOperationKind;
+	expectedRevisionId: string;
+	candidateSha256: string;
+	createdBy?: string;
+}
+
+export type BeginOperationResult =
+	| { status: "created" | "existing"; operation: MediaOperation }
+	| { status: "conflict" };
+
+/** Canonical identity of an operation request; the same ID may only repeat the same request. */
+export async function operationFingerprint(
+	input: Pick<BeginOperationInput, "kind" | "mediaId" | "expectedRevisionId" | "candidateSha256">,
+): Promise<string> {
+	return sha256Hex(
+		new TextEncoder().encode(
+			JSON.stringify([input.kind, input.mediaId, input.expectedRevisionId, input.candidateSha256]),
+		),
+	);
+}
+
+export function isOpenOperation(operation: Pick<MediaOperation, "state">): boolean {
+	return (OPEN_OPERATION_STATES as readonly string[]).includes(operation.state);
+}
+
+function changed(result: { numUpdatedRows: bigint }): boolean {
+	return result.numUpdatedRows > 0n;
+}
+
+/**
+ * Persistence for source revisions, retained-original records and the
+ * operation journal. It holds no storage handles and performs no I/O beyond
+ * the database; callers order storage work around these records.
+ */
+export class MediaOperationsRepository {
+	constructor(private readonly db: Kysely<Database>) {}
+
+	// --- Revisions ---------------------------------------------------------
+
+	async getRevision(id: string): Promise<MediaRevision | null> {
+		return (
+			(await this.db
+				.selectFrom("_emdash_media_revisions")
+				.selectAll()
+				.where("id", "=", id)
+				.executeTakeFirst()) ?? null
+		);
+	}
+
+	/**
+	 * The active revision of a ready media item, creating a baseline revision
+	 * for rows that have never been managed. Safe to race: exactly one baseline
+	 * wins and losers discard theirs.
+	 */
+	async ensureActiveRevision(mediaId: string): Promise<MediaRevision | null> {
+		const media = await this.db
+			.selectFrom("media")
+			.select([
+				"id",
+				"status",
+				"storage_key",
+				"mime_type",
+				"size",
+				"width",
+				"height",
+				"content_hash",
+				"revision_id",
+			])
+			.where("id", "=", mediaId)
+			.executeTakeFirst();
+		if (!media || media.status !== "ready") return null;
+
+		if (media.revision_id) {
+			const active = await this.getRevision(media.revision_id);
+			if (!active) throw new Error(`Media ${mediaId} points at a missing revision`);
+			return active;
+		}
+
+		const baseline = {
+			id: ulid(),
+			media_id: media.id,
+			kind: "baseline",
+			object_key: media.storage_key,
+			mime_type: media.mime_type,
+			size: media.size,
+			width: media.width,
+			height: media.height,
+			content_hash: media.content_hash,
+			sha256: null,
+		};
+		await this.db.insertInto("_emdash_media_revisions").values(baseline).execute();
+		const claimed = await this.db
+			.updateTable("media")
+			.set({ revision_id: baseline.id })
+			.where("id", "=", mediaId)
+			.where("revision_id", "is", null)
+			.executeTakeFirst();
+		if (changed(claimed)) return (await this.getRevision(baseline.id)) ?? null;
+
+		await this.db.deleteFrom("_emdash_media_revisions").where("id", "=", baseline.id).execute();
+		const winner = await this.db
+			.selectFrom("media")
+			.select("revision_id")
+			.where("id", "=", mediaId)
+			.executeTakeFirst();
+		return winner?.revision_id ? this.getRevision(winner.revision_id) : null;
+	}
+
+	/** Record a revision's SHA-256 once. A different digest already recorded is an error. */
+	async recordRevisionDigest(revisionId: string, sha256: string): Promise<void> {
+		if (!isSha256Hex(sha256)) throw new TypeError("Expected a lowercase hex SHA-256 digest");
+		await this.db
+			.updateTable("_emdash_media_revisions")
+			.set({ sha256 })
+			.where("id", "=", revisionId)
+			.where("sha256", "is", null)
+			.execute();
+		const revision = await this.getRevision(revisionId);
+		if (!revision) throw new Error(`Revision ${revisionId} does not exist`);
+		if (revision.sha256 !== sha256) {
+			throw new Error(`Revision ${revisionId} already records a different digest`);
+		}
+	}
+
+	// --- Retained originals ------------------------------------------------
+
+	async getOriginal(sha256: string): Promise<MediaOriginal | null> {
+		return (
+			(await this.db
+				.selectFrom("_emdash_media_originals")
+				.selectAll()
+				.where("sha256", "=", sha256)
+				.executeTakeFirst()) ?? null
+		);
+	}
+
+	/** Record an original after its private copy is verified. Repeating is a no-op, never a second backup. */
+	async recordOriginal(input: {
+		sha256: string;
+		storageKey: string;
+		size: number;
+		mimeType: string;
+	}): Promise<{ created: boolean; original: MediaOriginal }> {
+		if (!isSha256Hex(input.sha256)) throw new TypeError("Expected a lowercase hex SHA-256 digest");
+		const result = await this.db
+			.insertInto("_emdash_media_originals")
+			.values({
+				sha256: input.sha256,
+				storage_key: input.storageKey,
+				size: input.size,
+				mime_type: input.mimeType,
+			})
+			.onConflict((conflict) => conflict.column("sha256").doNothing())
+			.executeTakeFirst();
+		const original = await this.getOriginal(input.sha256);
+		if (!original) throw new Error("Original record was not persisted");
+		return { created: (result.numInsertedOrUpdatedRows ?? 0n) > 0n, original };
+	}
+
+	async backupTotals(): Promise<{ count: number; bytes: number }> {
+		const row = await this.db
+			.selectFrom("_emdash_media_originals")
+			.select((eb) => [
+				eb.fn.countAll<number>().as("count"),
+				eb.fn.coalesce(eb.fn.sum<number>("size"), eb.val(0)).as("bytes"),
+			])
+			.executeTakeFirstOrThrow();
+		return { count: Number(row.count), bytes: Number(row.bytes) };
+	}
+
+	// --- Operation journal -------------------------------------------------
+
+	async getOperation(mediaId: string, operationId: string): Promise<MediaOperation | null> {
+		return (
+			(await this.db
+				.selectFrom("_emdash_media_operations")
+				.selectAll()
+				.where("media_id", "=", mediaId)
+				.where("operation_id", "=", operationId)
+				.executeTakeFirst()) ?? null
+		);
+	}
+
+	/**
+	 * Record intent, or return the existing operation for a repeated identical
+	 * request. Reusing an ID with a different request is a conflict, including
+	 * after the media item has been deleted.
+	 */
+	async beginOperation(input: BeginOperationInput): Promise<BeginOperationResult> {
+		if (!isSha256Hex(input.candidateSha256)) {
+			throw new TypeError("Expected a lowercase hex SHA-256 digest");
+		}
+		const fingerprint = await operationFingerprint(input);
+		const now = new Date().toISOString();
+		const inserted = await this.db
+			.insertInto("_emdash_media_operations")
+			.values({
+				media_id: input.mediaId,
+				operation_id: input.operationId,
+				kind: input.kind,
+				state: "intent",
+				fingerprint,
+				expected_revision_id: input.expectedRevisionId,
+				candidate_sha256: input.candidateSha256,
+				candidate_revision_id: null,
+				original_sha256: null,
+				receipt: null,
+				error_code: null,
+				created_by: input.createdBy ?? null,
+				created_at: now,
+				updated_at: now,
+				completed_at: null,
+			})
+			.onConflict((conflict) => conflict.columns(["media_id", "operation_id"]).doNothing())
+			.executeTakeFirst();
+		const operation = await this.getOperation(input.mediaId, input.operationId);
+		if (!operation) throw new Error("Operation record was not persisted");
+		if ((inserted.numInsertedOrUpdatedRows ?? 0n) > 0n) return { status: "created", operation };
+		return operation.fingerprint === fingerprint
+			? { status: "existing", operation }
+			: { status: "conflict" };
+	}
+
+	/**
+	 * Move an open operation to its next state if it is still in `from`.
+	 * Returns null when another worker already advanced or finished it.
+	 */
+	async advanceOperation(
+		mediaId: string,
+		operationId: string,
+		from: OpenMediaOperationState,
+		fields: { candidateRevisionId?: string; originalSha256?: string | null } = {},
+	): Promise<MediaOperation | null> {
+		const next = NEXT_STATE[from];
+		if (!next) throw new Error(`An operation in ${from} advances only by publication`);
+		const row = await this.db
+			.updateTable("_emdash_media_operations")
+			.set({
+				state: next,
+				updated_at: new Date().toISOString(),
+				...(fields.candidateRevisionId === undefined
+					? {}
+					: { candidate_revision_id: fields.candidateRevisionId }),
+				...(fields.originalSha256 === undefined ? {} : { original_sha256: fields.originalSha256 }),
+			})
+			.where("media_id", "=", mediaId)
+			.where("operation_id", "=", operationId)
+			.where("state", "=", from)
+			.returningAll()
+			.executeTakeFirst();
+		return row ?? null;
+	}
+
+	/** Durably end an open operation without publishing. Terminal states are never overwritten. */
+	async finishOperation(
+		mediaId: string,
+		operationId: string,
+		outcome: { state: "rejected" | "aborted"; errorCode: string },
+	): Promise<MediaOperation | null> {
+		const now = new Date().toISOString();
+		const receipt = JSON.stringify({
+			status: "rejected",
+			code: outcome.errorCode,
+			operationId,
+		});
+		const row = await this.db
+			.updateTable("_emdash_media_operations")
+			.set({
+				state: outcome.state,
+				error_code: outcome.errorCode,
+				receipt,
+				updated_at: now,
+				completed_at: now,
+			})
+			.where("media_id", "=", mediaId)
+			.where("operation_id", "=", operationId)
+			.where("state", "in", [...OPEN_OPERATION_STATES])
+			.returningAll()
+			.executeTakeFirst();
+		return row ?? null;
+	}
+
+	async listOpenOperations(limit = 100): Promise<MediaOperation[]> {
+		return this.db
+			.selectFrom("_emdash_media_operations")
+			.selectAll()
+			.where("state", "in", [...OPEN_OPERATION_STATES])
+			.orderBy("created_at")
+			.limit(limit)
+			.execute();
+	}
+}
