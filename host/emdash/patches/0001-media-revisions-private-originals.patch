+				"_emdash_media_originals",
+				"_emdash_media_operations",
+			]),
+		);
+		const media = (await db.introspection.getTables()).find((table) => table.name === "media");
+		expect(media?.columns.map((column) => column.name)).toContain("revision_id");
+	});
+
+	it("leaves existing media unmanaged and is safe to run twice", async () => {
+		await down(db as Kysely<unknown>);
