+import type { Kysely } from "kysely";
+
+import { columnExists } from "../dialect-helpers.js";
+
+/**
+ * Safe media: public storage cleanup after publication.
+ *
+ * `_emdash_media_operations.public_cleaned_at` is set once a published
+ * operation's public storage has been brought in line with it: the media item's
+ * stable key holds the active revision's bytes and the superseded revision
+ * object is gone. NULL on a published operation means that work is still owed,
+ * which includes every operation published before this column existed.
+ */
+export async function up(db: Kysely<unknown>): Promise<void> {
+	if (!(await columnExists(db, "_emdash_media_operations", "public_cleaned_at"))) {
+		await db.schema
+			.alterTable("_emdash_media_operations")
+			.addColumn("public_cleaned_at", "text")
+			.execute();
+	}
+
+	await db.schema
+		.createIndex("idx_media_operations_public_cleaned")
+		.ifNotExists()
+		.on("_emdash_media_operations")
+		.columns(["public_cleaned_at", "state"])
+		.execute();
+}
+
+export async function down(db: Kysely<unknown>): Promise<void> {
+	await db.schema.dropIndex("idx_media_operations_public_cleaned").ifExists().execute();
+	if (await columnExists(db, "_emdash_media_operations", "public_cleaned_at")) {
+		await db.schema
+			.alterTable("_emdash_media_operations")
+			.dropColumn("public_cleaned_at")
+			.execute();
+	}
+}
