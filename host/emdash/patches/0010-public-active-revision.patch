index 0000000000000000000000000000000000000000..d9ff1dfd53a7600b755f83826b4caaa46a33a8cb
--- /dev/null
+++ b/packages/core/tests/unit/media/safe/public-scan.ts
@@ -0,0 +1,77 @@
+import { createHash } from "node:crypto";
+import { readdir, readFile } from "node:fs/promises";
+import { join } from "node:path";
+
+import type { Kysely } from "kysely";
+
+import type { Database } from "../../../../src/database/types.js";
+
+async function walk(directory: string, prefix = ""): Promise<string[]> {
+	const keys: string[] = [];
+	for (const entry of await readdir(join(directory, prefix), { withFileTypes: true })) {
+		const key = prefix ? `${prefix}/${entry.name}` : entry.name;
+		if (entry.isDirectory()) keys.push(...(await walk(directory, key)));
+		else keys.push(key);
+	}
+	return keys;
+}
+
+/**
+ * Scan every file of the public storage directory, as a file server mounted on
+ * it would expose them, and report what must not be there once publication and
+ * cleanup are complete:
+ *
+ * - a file whose digest is a retained original, unless it is the active
+ *   revision of a media item (at that revision's object key or at the item's
+ *   stable key);
+ * - a managed media item whose stable key does not hold its active revision.
+ */
+export async function publicStorageProblems(
+	db: Kysely<Database>,
+	uploadsDirectory: string,
+): Promise<string[]> {
+	const retained = new Set(
+		(await db.selectFrom("_emdash_media_originals").select("sha256").execute()).map(
+			(row) => row.sha256,
+		),
+	);
+	const media = await db
+		.selectFrom("media")
+		.leftJoin("_emdash_media_revisions", "_emdash_media_revisions.id", "media.revision_id")
+		.select([
+			"media.id",
+			"media.storage_key",
+			"_emdash_media_revisions.object_key",
+			"_emdash_media_revisions.sha256",
+		])
+		.execute();
+
+	/** Per key, the digests it may hold; `null` allows any (the item's bytes live only there). */
+	const allowed = new Map<string, Set<string | null>>();
+	const allow = (key: string, sha256: string | null) =>
+		allowed.set(key, (allowed.get(key) ?? new Set()).add(sha256));
+	for (const item of media) {
+		const inPlace = item.object_key === null || item.object_key === item.storage_key;
+		allow(item.storage_key, inPlace ? null : item.sha256);
+		if (!inPlace && item.object_key) allow(item.object_key, item.sha256);
+	}
+
+	const problems: string[] = [];
+	const digests = new Map<string, string>();
+	for (const key of await walk(uploadsDirectory)) {
+		const digest = createHash("sha256")
+			.update(await readFile(join(uploadsDirectory, key)))
+			.digest("hex");
+		digests.set(key, digest);
+		const may = allowed.get(key);
+		if (retained.has(digest) && !may?.has(null) && !may?.has(digest))
+			problems.push(`${key} holds retained original ${digest}`);
+	}
+	for (const item of media) {
+		if (item.object_key === null || item.object_key === item.storage_key) continue;
+		if (media.filter((other) => other.storage_key === item.storage_key).length > 1) continue;
+		if (digests.get(item.storage_key) !== item.sha256)
+			problems.push(`${item.storage_key} does not hold the active revision of ${item.id}`);
+	}
+	return problems.toSorted();
+}
