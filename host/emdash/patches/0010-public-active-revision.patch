+import type { Kysely } from "kysely";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { down, up } from "../../../../src/database/migrations/093_safe_media_public_cleanup.js";
+import { MediaOperationsRepository } from "../../../../src/database/repositories/media-operations.js";
+import type { Database } from "../../../../src/database/types.js";
+import { setupTestDatabase, teardownTestDatabase } from "../../../utils/test-db.js";
+
+const DIGEST = "a".repeat(64);
+
+describe("093_safe_media_public_cleanup migration", () => {
+	let db: Kysely<Database>;
+
+	beforeEach(async () => {
+		db = await setupTestDatabase();
+	});
+
+	afterEach(async () => {
+		await teardownTestDatabase(db);
+	});
+
+	async function columns(): Promise<string[]> {
+		const table = (await db.introspection.getTables()).find(
+			(each) => each.name === "_emdash_media_operations",
+		);
+		return table?.columns.map((column) => column.name) ?? [];
+	}
+
+	it("marks operations published before it as owing a public cleanup, and is safe to run twice", async () => {
+		await down(db as Kysely<unknown>);
+		expect(await columns()).not.toContain("public_cleaned_at");
+		const now = new Date().toISOString();
+		const operation = {
+			media_id: "media-1",
+			kind: "replace",
+			fingerprint: "f",
+			expected_revision_id: "r0",
+			candidate_sha256: DIGEST,
+			candidate_revision_id: "r1",
+			original_sha256: DIGEST,
+			receipt: null,
+			error_code: null,
+			created_by: null,
+			created_at: now,
+			updated_at: now,
+			completed_at: now,
+		};
+		await db
+			.insertInto("_emdash_media_operations")
+			.values([
+				{ ...operation, operation_id: "published", state: "published" },
+				{ ...operation, operation_id: "rejected", state: "rejected" },
+				{ ...operation, operation_id: "open", state: "original_retained", completed_at: null },
+			] as never)
+			.execute();
+
+		await up(db as Kysely<unknown>);
+		await up(db as Kysely<unknown>);
+
+		expect(await columns()).toContain("public_cleaned_at");
+		const repo = new MediaOperationsRepository(db);
+		expect((await repo.listPendingPublicCleanups()).map((each) => each.operation_id)).toEqual([
+			"published",
+		]);
+		await repo.markPublicCleaned("media-1", "published");
+		expect(await repo.listPendingPublicCleanups()).toEqual([]);
+		// Only a published operation can be marked.
+		await repo.markPublicCleaned("media-1", "open");
+		expect((await repo.getOperation("media-1", "open"))?.public_cleaned_at ?? null).toBeNull();
+	});
+});
