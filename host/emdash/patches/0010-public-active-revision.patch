new file mode 100644
index 0000000000000000000000000000000000000000..2775683c3392f8be9568859aed4472f5feba85ba
--- /dev/null
+++ b/packages/core/src/media/safe/public-objects.ts
@@ -0,0 +1,163 @@
+/**
+ * Public storage after a publication.
+ *
+ * Publication moves the media row's pointer; the public storage is brought in
+ * line afterwards, in two repeatable steps:
+ *
+ * - the media item's stable key is rewritten with the active revision's bytes,
+ *   so a reader that bypasses the host (a file server on the storage directory,
+ *   an EmDash version without revisions) serves the active image, and
+ * - the revision object that was superseded is removed.
+ *
+ * Neither step removes or overwrites bytes until the same bytes are verified
+ * in the private original store and recorded there. Readers that go through
+ * the host are unaffected: they resolve the active revision's own object,
+ * which these steps never touch.
+ */
+
+import type { MediaOperationsRepository } from "../../database/repositories/media-operations.js";
+import type { Storage } from "../../storage/types.js";
+import { sha256Hex } from "./digest.js";
+import type { KeyedLock } from "./keyed-lock.js";
+import type { PrivateOriginalStore } from "./private-originals.js";
+import { PrivateOriginalError } from "./private-originals.js";
+import type { StableKeyWriter } from "./public-local.js";
+import { MEDIA_REVISIONS_PREFIX } from "./revision-keys.js";
+
+export interface PublicObjectsContext {
+	repo: MediaOperationsRepository;
+	/** The public storage itself, not the revision-aware view of it. */
+	storage: Storage;
+	originals: PrivateOriginalStore;
+	withLock: KeyedLock;
+	/** Atomic replacement of a stable key; without it the storage's own upload is used. */
+	stableKeys?: StableKeyWriter;
+	isCandidateInFlight: (sha256: string) => boolean;
+}
+
+async function readObject(storage: Storage, key: string): Promise<Uint8Array | null> {
+	try {
+		const result = await storage.download(key);
+		return new Uint8Array(await new Response(result.body).arrayBuffer());
+	} catch {
+		return null;
+	}
+}
+
+/**
+ * Make sure `bytes` are held, verified, in the private store and recorded.
+ * With `recordUnknown` unset, bytes that no record names are left alone and
+ * the result is false.
+ */
+async function ensureRetained(
+	context: PublicObjectsContext,
+	bytes: Uint8Array,
+	mimeType: string,
+	options: { recordUnknown: boolean },
+): Promise<boolean> {
+	const sha256 = await sha256Hex(bytes);
+	return context.withLock(`original:${sha256}`, async () => {
+		const record = await context.repo.getOriginal(sha256);
+		if (!record && !options.recordUnknown) return false;
+		// Verifies the private copy against its digest and rewrites a missing or damaged one.
+		const retained = await context.originals.retain(bytes, record?.mime_type ?? mimeType);
+		if (!record)
+			await context.repo.recordOriginal({
+				sha256: retained.sha256,
+				storageKey: retained.storageKey,
+				size: retained.size,
+				mimeType,
+			});
+		return true;
+	});
+}
+
+/**
+ * Rewrite a media item's stable key with its active revision's bytes. Returns
+ * the key when it was rewritten, null when it already held them or the item
+ * has no separate stable object to maintain. Throws when the active revision
+ * cannot be read back verified, leaving the stable key as it was.
+ */
+export async function mirrorActiveRevision(
+	context: PublicObjectsContext,
+	mediaId: string,
+): Promise<string | null> {
+	const { repo, storage } = context;
+	return context.withLock(`stable:${mediaId}`, async () => {
+		const media = await repo.getManagedMedia(mediaId);
+		if (!media || media.objectKey === media.storageKey) return null;
+		// The key is another row's object too; its bytes are not this item's alone to replace.
+		if ((await repo.countMediaWithStorageKey(media.storageKey)) > 1) return null;
+
+		const active = await readObject(storage, media.objectKey);
+		if (!active || !media.sha256 || (await sha256Hex(active)) !== media.sha256)
+			throw new Error(`The active revision of media ${mediaId} could not be read back verified`);
+
+		const current = await readObject(storage, media.storageKey);
+		if (current) {
+			if ((await sha256Hex(current)) === media.sha256) return null;
+			await ensureRetained(context, current, media.mimeType, { recordUnknown: true });
+		} else if (await storage.exists(media.storageKey)) {
+			throw new Error(`The stable object of media ${mediaId} exists but could not be read`);
+		}
+
+		if (context.stableKeys) await context.stableKeys.write(media.storageKey, active);
+		else await storage.upload({ key: media.storageKey, body: active, contentType: media.mimeType });
+		const written = await readObject(storage, media.storageKey);
+		if (!written || (await sha256Hex(written)) !== media.sha256)
+			throw new Error(`The stable object of media ${mediaId} does not match the active revision`);
+
+		// Deleted meanwhile: the deletion may have removed the stable object before this write.
+		if (!(await repo.getManagedMedia(mediaId))) {
+			await storage.delete(media.storageKey);
+			return null;
+		}
+		return media.storageKey;
+	});
+}
+
+function digestOfRevisionKey(key: string): string {
+	return key.slice(MEDIA_REVISIONS_PREFIX.length).split(".")[0] ?? "";
+}
+
+/**
+ * Remove a revision object nothing needs. `orphan`: no record gives it any
+ * history (allowed only with `orphans`, for objects past the grace period).
+ * `superseded`: it was published and is no media item's active revision any
+ * more, and its bytes are verified in the private store. Null when it is kept.
+ */
+export async function removeRevisionObject(
+	context: PublicObjectsContext,
+	key: string,
+	options: { orphans: boolean; superseded: boolean },
+): Promise<"orphan" | "superseded" | null> {
+	const { repo, storage } = context;
+	if (!key.startsWith(MEDIA_REVISIONS_PREFIX)) return null;
+	const named = digestOfRevisionKey(key);
+	return context.withLock(`object:${key}`, async () => {
+		if (context.isCandidateInFlight(named)) return null;
+		if (await repo.hasOpenOperationForCandidate(named)) return null;
+		if (!(await repo.isRevisionObjectInUse(key))) {
+			if (!options.orphans) return null;
+			await storage.delete(key);
+			return "orphan";
+		}
+		if (!options.superseded || (await repo.isRevisionObjectActive(key))) return null;
+		const bytes = await readObject(storage, key);
+		if (!bytes) return null;
+		try {
+			if (
+				!(await ensureRetained(context, bytes, "application/octet-stream", {
+					recordUnknown: false,
+				}))
+			)
+				return null;
+		} catch (error) {
+			// Without a verified private copy the public object is the only one; it stays.
+			if (error instanceof PrivateOriginalError) return null;
+			throw error;
+		}
+		await storage.delete(key);
+		return "superseded";
+	});
+}
