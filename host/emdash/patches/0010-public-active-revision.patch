+describe("LocalStorage download", () => {
+	let directory: string | undefined;
+
+	afterEach(async () => {
+		if (directory) await rm(directory, { recursive: true, force: true });
+	});
+
+	async function stored(bytes: Uint8Array) {
+		directory = await mkdtemp(join(tmpdir(), "emdash-local-storage-"));
+		const storage = new LocalStorage({ directory, baseUrl: "/media" });
+		await storage.upload({ key: "photo.png", body: bytes, contentType: "image/png" });
+		return storage;
+	}
+
+	it("reads the file it reported, in full, when the key is removed before the body is read", async () => {
+		const storage = await stored(new Uint8Array([1, 2, 3, 4]));
+		const result = await storage.download("photo.png");
+		unlinkSync(join(directory!, "photo.png"));
+		expect(result.size).toBe(4);
+		expect(new Uint8Array(await new Response(result.body).arrayBuffer())).toEqual(
+			new Uint8Array([1, 2, 3, 4]),
+		);
+		await expect(storage.download("photo.png")).rejects.toMatchObject({ code: "NOT_FOUND" });
+	});
+
+	it("reads the file it reported, in full, when another file is renamed onto the key before the body is read", async () => {
+		const storage = await stored(new Uint8Array([1, 2, 3, 4]));
+		const result = await storage.download("photo.png");
+		writeFileSync(join(directory!, "next"), new Uint8Array([9, 8]));
+		renameSync(join(directory!, "next"), join(directory!, "photo.png"));
+		expect(result.size).toBe(4);
+		expect(new Uint8Array(await new Response(result.body).arrayBuffer())).toEqual(
+			new Uint8Array([1, 2, 3, 4]),
+		);
+	});
+
+	it("reports a missing key and a directory as not found", async () => {
+		const storage = await stored(new Uint8Array([1]));
+		await storage.upload({
+			key: "nested/inner.png",
+			body: new Uint8Array([1]),
+			contentType: "image/png",
+		});
+		await expect(storage.download("absent.png")).rejects.toMatchObject({ code: "NOT_FOUND" });
+		await expect(storage.download("nested")).rejects.toMatchObject({ code: "NOT_FOUND" });
+		await expect(storage.download("photo.png/inner")).rejects.toMatchObject({ code: "NOT_FOUND" });
+	});
+});
