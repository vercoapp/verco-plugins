diff --git a/packages/core/src/media/safe/public-local.ts b/packages/core/src/media/safe/public-local.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2af235954590491e19d0947ddb436476c6075037
--- /dev/null
+++ b/packages/core/src/media/safe/public-local.ts
@@ -0,0 +1,79 @@
+/**
+ * Atomic replacement of an object in the local public storage (Node only).
+ *
+ * The stable key of a media item is rewritten after a publication so that it
+ * holds the active revision's bytes. Whatever reads that file without going
+ * through the host (a file server on the storage directory, an earlier EmDash
+ * version) must see the previous or the new bytes in full, so the bytes are
+ * written to a temporary name, flushed and renamed into place.
+ */
+
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+
+import { EmDashStorageError } from "../../storage/types.js";
+import { MEDIA_REVISIONS_PREFIX } from "./revision-keys.js";
+
+export interface StableKeyWriter {
+	/** Replace the object at `key`; a concurrent reader sees the previous or the new bytes, never a mixture. */
+	write(key: string, bytes: Uint8Array): Promise<void>;
+	/** Remove temporary files of interrupted writes last modified before `before`; returns how many. */
+	removeTemporaryFiles(before: Date): Promise<number>;
+}
+
+const TEMPORARY_PREFIX = "stable-";
+const TEMPORARY_SUFFIX = ".tmp";
+
+export function createLocalStableKeyWriter(storageDirectory: string): StableKeyWriter {
+	const directory = path.resolve(storageDirectory);
+	// Inside the storage directory so the rename stays on one filesystem, and under a
+	// prefix the public route refuses.
+	const temporaryDirectory = path.join(directory, MEDIA_REVISIONS_PREFIX);
+
+	return {
+		async write(key, bytes) {
+			const target = path.resolve(directory, key);
+			if (!key || key.includes("\0") || !target.startsWith(directory + path.sep)) {
+				throw new EmDashStorageError("Invalid file path", "INVALID_PATH");
+			}
+			const temporary = path.join(
+				temporaryDirectory,
+				`${TEMPORARY_PREFIX}${crypto.randomUUID()}${TEMPORARY_SUFFIX}`,
+			);
+			try {
+				await fs.mkdir(temporaryDirectory, { recursive: true });
+				const handle = await fs.open(temporary, "wx");
+				try {
+					await handle.writeFile(bytes);
+					await handle.sync();
+				} finally {
+					await handle.close();
+				}
+				await fs.rename(temporary, target);
+				const parent = await fs.open(path.dirname(target), "r");
+				try {
+					await parent.sync();
+				} finally {
+					await parent.close();
+				}
+			} catch (error) {
+				await fs.rm(temporary, { force: true });
+				throw new EmDashStorageError(`Failed to replace file: ${key}`, "UPLOAD_FAILED", error);
+			}
+		},
+
+		async removeTemporaryFiles(before) {
+			let removed = 0;
+			for (const name of await fs.readdir(temporaryDirectory).catch((): string[] => [])) {
+				if (!name.startsWith(TEMPORARY_PREFIX) || !name.endsWith(TEMPORARY_SUFFIX)) continue;
+				const full = path.join(temporaryDirectory, name);
+				const stat = await fs.stat(full).catch(() => null);
+				if (stat?.isFile() && stat.mtime < before) {
+					await fs.rm(full, { force: true });
+					removed++;
+				}
+			}
+			return removed;
+		},
+	};
+}
