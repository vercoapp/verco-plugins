+/**
+ * Recovery of safe media without the site runtime.
+ *
+ * Opens the site's SQLite database and storage directories directly, so a
+ * retained original can be listed and restored, and interrupted operations
+ * reconciled, with no plugin installed and without starting the site. It uses
+ * the same replacement service, journal and fence as the running site.
+ *
+ * Node, SQLite and local storage only. The service's locks cover this process
+ * alone, so reconcile from here only while the site is stopped; a restore is
+ * fenced by the database and is safe while the site runs.
+ */
+
+import { existsSync } from "node:fs";
+import { join, resolve } from "node:path";
+
+import { Kysely, SqliteDialect, sql } from "kysely";
+import { ulid } from "ulidx";
+
+import type { Database } from "../../database/types.js";
+import { openNodeSqliteDatabase } from "../../db/node-sqlite-compat.js";
+import { LocalStorage } from "../../storage/local.js";
+import { ImageDecodeError } from "./decoder.js";
+import { createLocalPrivateStorage } from "./private-local.js";
+import { createPrivateOriginalStore } from "./private-originals.js";
+import type { ReconcileOptions, ReconciliationReport } from "./reconciliation.js";
+import type { ReplaceResult, RestorableOriginal } from "./replacement-service.js";
+import { createMediaReplacementService } from "./replacement-service.js";
+import { createOutputValidator } from "./validate-output.js";
+
+export interface OpenSafeMediaRecoveryOptions {
+	/** The site's SQLite database file. It must exist and have migration 092 applied. */
+	databasePath: string;
+	/** The directory of the local media storage (`local({ directory })`). */
+	uploadsDirectory: string;
+	/** `safeMedia.privateDirectory`. */
+	privateDirectory: string;
+	/** Directories served publicly that the private directory must stay out of; defaults to `./public`. */
+	publicDirectories?: string[];
+}
+
+export interface RestoreMediaOptions {
+	/** A retained original of this media item; defaults to the one replaced by the active revision. */
+	originalSha256?: string;
+	/** Defaults to the active revision. Pass the revision you inspected to fail on a concurrent change. */
+	expectedRevisionId?: string;
+	/** Repeat an earlier call's ID to get its receipt again; defaults to a new ID. */
+	operationId?: string;
+}
+
+export interface SafeMediaRecovery {
+	listRestorableOriginals(mediaId: string): Promise<RestorableOriginal[]>;
+	/** Restore a retained original's exact bytes onto an existing media item. */
+	restoreMedia(mediaId: string, options?: RestoreMediaOptions): Promise<ReplaceResult>;
+	reconcile(options?: ReconcileOptions): Promise<ReconciliationReport>;
+	close(): Promise<void>;
+}
+
+export class SafeMediaRecoveryError extends Error {
+	constructor(message: string) {
+		super(message);
+		this.name = "SafeMediaRecoveryError";
+	}
+}
+
+export async function openSafeMediaRecovery(
+	options: OpenSafeMediaRecoveryOptions,
+): Promise<SafeMediaRecovery> {
+	const databasePath = resolve(options.databasePath);
+	// Opening a missing file would silently create an empty database.
+	if (!existsSync(databasePath)) throw new SafeMediaRecoveryError(`No database at ${databasePath}`);
+	const db = new Kysely<Database>({
+		dialect: new SqliteDialect({ database: openNodeSqliteDatabase(databasePath) }),
+	});
+	try {
+		const tables = await sql<{
+			name: string;
+		}>`SELECT name FROM sqlite_master WHERE type = 'table' AND name = ${"_emdash_media_operations"}`.execute(
+			db,
+		);
+		if (tables.rows.length === 0)
+			throw new SafeMediaRecoveryError("The database has no safe media records (migration 092)");
+		const storage = new LocalStorage({
+			directory: options.uploadsDirectory,
+			baseUrl: "/_emdash/api/media/file",
+		});
+		const originals = createPrivateOriginalStore(
+			createLocalPrivateStorage({
+				directory: options.privateDirectory,
+				publicDirectories: [
+					resolve(options.uploadsDirectory),
+					...(options.publicDirectories ?? [join(process.cwd(), "public")]),
+				],
+			}),
+		);
+		const service = createMediaReplacementService({
+			db,
+			storage,
+			originals,
+			// Recovery never replaces with new bytes, so it needs no decoder.
+			validator: createOutputValidator({
+				decoder: {
+					decode: () =>
+						Promise.reject(new ImageDecodeError("DECODER_UNAVAILABLE", "Recovery does not decode")),
+				},
+			}),
+		});
+		return {
+			listRestorableOriginals: (mediaId) => service.listRestorableOriginals(mediaId),
+			async restoreMedia(mediaId, restoreOptions = {}) {
+				// A repeated operation ID means the request recorded for it, so its receipt comes back.
+				const earlier = restoreOptions.operationId
+					? await db
+							.selectFrom("_emdash_media_operations")
+							.select(["expected_revision_id", "candidate_sha256"])
+							.where("media_id", "=", mediaId)
+							.where("operation_id", "=", restoreOptions.operationId)
+							.where("kind", "=", "restore")
+							.executeTakeFirst()
+					: undefined;
+				const expectedRevisionId =
+					restoreOptions.expectedRevisionId ??
+					earlier?.expected_revision_id ??
+					(
+						await db
+							.selectFrom("media")
+							.select("revision_id")
+							.where("id", "=", mediaId)
+							.executeTakeFirst()
+					)?.revision_id;
+				if (!expectedRevisionId)
+					return {
+						ok: false,
+						code: "CONFLICT",
+						message: "The media item does not exist or has never been replaced.",
+						retryable: false,
+					};
+				return service.restore({
+					mediaId,
+					operationId: restoreOptions.operationId ?? `recovery-${ulid()}`,
+					expectedRevisionId,
+					originalSha256: restoreOptions.originalSha256 ?? earlier?.candidate_sha256,
+					createdBy: "recovery",
+				});
+			},
+			reconcile: (reconcileOptions) => service.reconcile(reconcileOptions),
+			close: () => db.destroy(),
+		};
+	} catch (error) {
+		await db.destroy();
+		throw error;
+	}
+}
