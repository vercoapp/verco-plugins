+		};
+		expect(await codeOf(png, "image/png", { decoder: mismatched })).toBe("DIMENSIONS_CHANGED");
+	});
+
+	it("refuses to compare against a source with unknown geometry", async () => {
+		const { png } = await stills();
+		const validator = createOutputValidator({ decoder: forbiddenDecoder() });
+		expect(await validator.validate(png, source("image/png", null, null))).toMatchObject({
+			ok: false,
+			code: "SOURCE_GEOMETRY_UNKNOWN",
+		});
+		expect(await validator.validate(png, source("image/png", 64, 0))).toMatchObject({
+			ok: false,
+			code: "SOURCE_GEOMETRY_UNKNOWN",
+		});
+	});
+});
+
+describe("oversized output", () => {
+	it("rejects output over the byte limit before reading it", async () => {
+		const { png } = await stills();
+		const decoder = forbiddenDecoder();
+		expect(
+			await codeOf(png, "image/png", { decoder, limits: { maxBytes: png.byteLength - 1 } }),
+		).toBe("TOO_LARGE_BYTES");
+		expect(
+			await codeOf(png, "image/png", {
+				decoder: inProcessDecoder,
+				limits: { maxBytes: png.byteLength },
+			}),
+		).toBe("OK");
+		expect(decoder.calls).toBe(0);
+	});
+
+	it("rejects a pixel bomb from its header, without spawning a decoder", async () => {
+		const bomb = await solid(12000, 12000).png({ compressionLevel: 9 }).toBuffer();
+		expect(bomb.byteLength).toBeLessThan(1_000_000); // a small file that declares 144 MP
+		const decoder = forbiddenDecoder();
+		expect(await codeOf(bomb, "image/png", { decoder, width: 12000, height: 12000 })).toBe(
+			"TOO_MANY_PIXELS",
+		);
+		expect(decoder.calls).toBe(0);
+	});
+
+	it("applies the pixel limit exactly at its boundary", async () => {
+		const { png } = await stills();
+		expect(
+			await codeOf(png, "image/png", {
+				decoder: inProcessDecoder,
+				limits: { maxPixels: 64 * 48, maxInFlightPixels: 64 * 48 },
+			}),
+		).toBe("OK");
+		expect(
+			await codeOf(png, "image/png", {
+				decoder: forbiddenDecoder(),
+				limits: { maxPixels: 64 * 48 - 1, maxInFlightPixels: 64 * 48 },
+			}),
+		).toBe("TOO_MANY_PIXELS");
+	});
+
+	it("passes the pixel limit to the decoder, which refuses a header that lies", async () => {
+		const { png } = await stills();
+		const seen: number[] = [];
+		const spy: FullImageDecoder = {
+			decode: async (_bytes, request) => {
+				seen.push(request.maxPixels);
+				throw new ImageDecodeError("TOO_MANY_PIXELS", "x");
+			},
+		};
+		expect(
+			await codeOf(png, "image/png", {
