+import { createHash } from "node:crypto";
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import sharp from "sharp";
+import { describe, expect, it, vi } from "vitest";
+
+import { createDecodeAdmission } from "../../../../src/media/safe/admission.js";
+import type { FullImageDecoder } from "../../../../src/media/safe/decoder.js";
+import { ImageDecodeError } from "../../../../src/media/safe/decoder.js";
+import { createSharpChildDecoder } from "../../../../src/media/safe/sharp-child-decoder.js";
+import type { OutputRejectionCode } from "../../../../src/media/safe/validate-output.js";
+import { createOutputValidator } from "../../../../src/media/safe/validate-output.js";
+import {
+	animatedGif,
+	animatedWebp,
+	inProcessDecoder,
+	noisy,
+	prng,
+	SOURCE,
+	solid,
+	stills,
+	withAnimationControl,
+} from "./output-fixtures.js";
+
+const childDecoder = createSharpChildDecoder();
+const source = (
+	mimeType: string,
+	width: number | null = SOURCE.width,
+	height: number | null = SOURCE.height,
+) => ({ mimeType, width, height });
+const MIME = { jpeg: "image/jpeg", png: "image/png", webp: "image/webp" } as const;
+
+async function codeOf(
+	bytes: Uint8Array,
+	mimeType: string,
+	options: {
+		decoder?: FullImageDecoder;
+		limits?: Parameters<typeof createOutputValidator>[0]["limits"];
+		width?: number;
+		height?: number;
+	} = {},
+): Promise<OutputRejectionCode | "OK"> {
+	const validator = createOutputValidator({
+		decoder: options.decoder ?? childDecoder,
+		limits: options.limits,
+	});
+	const result = await validator.validate(
+		bytes,
+		source(mimeType, options.width ?? SOURCE.width, options.height ?? SOURCE.height),
+	);
+	return result.ok ? "OK" : result.code;
+}
+
+/** A decoder that must never run: proves the header checks refuse before any decode. */
+function forbiddenDecoder(): FullImageDecoder & { calls: number } {
+	const decoder = {
+		calls: 0,
+		async decode(): Promise<never> {
+			decoder.calls++;
+			throw new Error("The decoder must not run for this input");
+		},
+	};
+	return decoder;
+}
+
+describe("valid output", () => {
+	it.each(["jpeg", "png", "webp"] as const)(
+		"accepts a still %s of unchanged dimensions after a full decode",
+		async (format) => {
+			const bytes = (await stills())[format];
+			const validator = createOutputValidator({ decoder: childDecoder });
+			const result = await validator.validate(bytes, source(MIME[format]));
+			expect(result).toMatchObject({
+				ok: true,
+				format,
+				mimeType: MIME[format],
+				width: 64,
+				height: 48,
+				size: bytes.byteLength,
+			});
+			expect(result.ok && result.sha256).toMatch(/^[0-9a-f]{64}$/);
+		},
+	);
+
+	it("accepts the image/jpg alias and a MIME type with parameters", async () => {
+		const { jpeg } = await stills();
+		expect(await codeOf(jpeg, "image/jpg", { decoder: inProcessDecoder })).toBe("OK");
+		expect(await codeOf(jpeg, "IMAGE/JPEG; charset=binary", { decoder: inProcessDecoder })).toBe(
+			"OK",
+		);
+	});
+
+	it("compares stored-pixel dimensions, so an EXIF orientation tag does not change geometry", async () => {
+		const oriented = await solid(64, 48).jpeg().withMetadata({ orientation: 6 }).toBuffer();
+		expect(await codeOf(oriented, "image/jpeg", { decoder: inProcessDecoder })).toBe("OK");
+		expect(
+			await codeOf(oriented, "image/jpeg", { decoder: inProcessDecoder, width: 48, height: 64 }),
+		).toBe("DIMENSIONS_CHANGED");
+	});
+});
+
+describe("malformed output", () => {
+	it("rejects empty and non-image bytes without decoding", async () => {
+		const decoder = forbiddenDecoder();
+		expect(await codeOf(new Uint8Array(0), "image/png", { decoder })).toBe("EMPTY");
+		expect(
+			await codeOf(new TextEncoder().encode("definitely not an image"), "image/png", { decoder }),
+		).toBe("UNDECODABLE");
+		expect(await codeOf(new Uint8Array(4096), "image/png", { decoder })).toBe("UNDECODABLE");
+		expect(decoder.calls).toBe(0);
+	});
+
+	it.each(["jpeg", "png", "webp"] as const)("rejects a truncated %s", async (format) => {
+		const bytes = await noisy(64, 48, format);
+		for (const fraction of [0.3, 0.6, 0.9]) {
+			expect(["UNDECODABLE", "CORRUPT"]).toContain(
+				await codeOf(bytes.subarray(0, Math.floor(bytes.length * fraction)), MIME[format], {
+					decoder: childDecoder,
+				}),
+			);
+		}
+	});
+
+	it.each(["jpeg", "png", "webp"] as const)(
+		"rejects a damaged %s when the caller declares the digest it sent",
+		async (format) => {
+			const original = await noisy(64, 48, format);
+			const bytes = Buffer.from(original);
+			const start = Math.floor(bytes.length * 0.5);
+			for (let index = start; index < Math.min(start + 48, bytes.length); index++)
+				bytes[index] ^= 0xa5;
+			const validator = createOutputValidator({ decoder: childDecoder });
+			const result = await validator.validate(bytes, source(MIME[format]), {
+				expectedSha256: createHash("sha256").update(original).digest("hex"),
+			});
+			expect(result).toMatchObject({ ok: false, code: "DIGEST_MISMATCH" });
+		},
+	);
+
+	it("documents that decoding alone cannot prove lossy pixel data is intact", async () => {
+		// Damage inside entropy-coded data often still decodes. PNG's checksums catch it; WebP and JPEG may not.
+		const accepted: string[] = [];
+		for (const format of ["jpeg", "webp"] as const) {
+			const original = await noisy(64, 48, format);
+			for (let attempt = 0; attempt < 40; attempt++) {
+				const bytes = Buffer.from(original);
+				bytes[Math.floor(bytes.length * (0.4 + attempt / 100))] ^= 0x55;
+				if ((await codeOf(bytes, MIME[format], { decoder: inProcessDecoder })) === "OK")
+					accepted.push(format);
+			}
+		}
+		expect(accepted.length).toBeGreaterThan(0);
+	});
+
+	it("accepts a matching digest and treats it case-sensitively", async () => {
+		const { png } = await stills();
+		const digest = createHash("sha256").update(png).digest("hex");
+		const validator = createOutputValidator({ decoder: inProcessDecoder });
+		expect(
+			(await validator.validate(png, source("image/png"), { expectedSha256: digest })).ok,
+		).toBe(true);
+		expect(
+			await validator.validate(png, source("image/png"), { expectedSha256: digest.toUpperCase() }),
+		).toMatchObject({ code: "DIGEST_MISMATCH" });
+	});
+
+	it("never returns success for a mutated image unless it decodes to the source geometry", async () => {
+		const random = prng(7);
+		const corpus = Object.entries(await stills());
+		let accepted = 0;
+		for (let round = 0; round < 240; round++) {
+			const [format, original] = corpus[round % corpus.length]!;
+			const bytes = Buffer.from(original);
+			for (let flips = 0; flips < 1 + Math.floor(random() * 4); flips++)
+				bytes[Math.floor(random() * bytes.length)] ^= 1 << Math.floor(random() * 8);
+			const result = await createOutputValidator({ decoder: inProcessDecoder }).validate(
+				bytes,
+				source(MIME[format as keyof typeof MIME]),
+			);
+			if (result.ok) {
+				accepted++;
+				expect([result.width, result.height]).toEqual([64, 48]);
+				expect(result.format).toBe(format);
+			} else {
+				expect(result.code).not.toBe("DECODER_CRASHED");
+			}
+		}
+		expect(accepted).toBeLessThan(240); // some mutations must be caught
+	});
+});
+
+describe("wrong format", () => {
+	it("rejects output whose signature differs from the source MIME type, whatever it is called", async () => {
+		const { jpeg, png, webp } = await stills();
+		const decoder = forbiddenDecoder();
+		expect(await codeOf(jpeg, "image/png", { decoder })).toBe("WRONG_FORMAT");
+		expect(await codeOf(png, "image/jpeg", { decoder })).toBe("WRONG_FORMAT");
+		expect(await codeOf(webp, "image/png", { decoder })).toBe("WRONG_FORMAT");
+		expect(await codeOf(png, "image/webp", { decoder })).toBe("WRONG_FORMAT");
+		expect(decoder.calls).toBe(0);
+	});
+
+	it("rejects a decoder that reports a different format than the header", async () => {
+		const { png } = await stills();
+		const liar: FullImageDecoder = {
+			decode: async () => ({ format: "jpeg", width: 64, height: 48, frames: 1 }),
+		};
+		expect(await codeOf(png, "image/png", { decoder: liar })).toBe("WRONG_FORMAT");
+	});
+});
+
+describe("changed dimensions", () => {
+	it("rejects any change in width or height before decoding", async () => {
+		const decoder = forbiddenDecoder();
+		const wider = await solid(65, 48).png().toBuffer();
+		const taller = await solid(64, 49).png().toBuffer();
+		const swapped = await solid(48, 64).png().toBuffer();
+		const scaled = await solid(32, 24).png().toBuffer();
+		for (const bytes of [wider, taller, swapped, scaled])
+			expect(await codeOf(bytes, "image/png", { decoder })).toBe("DIMENSIONS_CHANGED");
+		expect(decoder.calls).toBe(0);
+	});
+
+	it("rejects when the decoder disagrees with the header on dimensions", async () => {
+		const { png } = await stills();
