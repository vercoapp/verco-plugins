+
+describe("unsupported images", () => {
+	it("rejects recognised formats outside the supported set without decoding", async () => {
+		const decoder = forbiddenDecoder();
+		const gif = await solid(64, 48).gif().toBuffer();
+		const tiff = await solid(64, 48).tiff().toBuffer();
+		const avif = await solid(64, 48).avif().toBuffer();
+		const svg = new TextEncoder().encode(
+			'<svg xmlns="http://www.w3.org/2000/svg" width="64" height="48"><script>alert(1)</script></svg>',
+		);
+		const bmp = Buffer.concat([Buffer.from("BM"), Buffer.alloc(60)]);
+		for (const bytes of [gif, tiff, avif, svg, bmp]) {
+			expect(await codeOf(bytes, "image/png", { decoder })).toBe("UNSUPPORTED_FORMAT");
+		}
+		expect(decoder.calls).toBe(0);
+	});
+
+	it("rejects an unsupported source type even when the output is a valid supported image", async () => {
+		const { png } = await stills();
+		expect(await codeOf(png, "image/gif", { decoder: forbiddenDecoder() })).toBe(
+			"UNSUPPORTED_FORMAT",
+		);
+		expect(await codeOf(png, "image/svg+xml", { decoder: forbiddenDecoder() })).toBe(
+			"UNSUPPORTED_FORMAT",
+		);
+		expect(await codeOf(png, "application/octet-stream", { decoder: forbiddenDecoder() })).toBe(
+			"UNSUPPORTED_FORMAT",
+		);
+	});
+
+	it("rejects animated WebP, APNG and animated GIF", async () => {
+		const decoder = forbiddenDecoder();
+		const webp = await animatedWebp();
+		expect((await sharp(webp).metadata()).pages).toBe(2);
+		expect(await codeOf(webp, "image/webp", { decoder })).toBe("ANIMATED");
+		const { png } = await stills();
+		expect(await codeOf(withAnimationControl(png), "image/png", { decoder })).toBe("ANIMATED");
+		expect(await codeOf(await animatedGif(), "image/gif", { decoder })).toBe("UNSUPPORTED_FORMAT");
+		expect(await codeOf(await animatedGif(), "image/png", { decoder })).toBe("UNSUPPORTED_FORMAT");
+		expect(decoder.calls).toBe(0);
+	});
+
+	it("rejects a WebP that only sets the VP8X animation flag", async () => {
+		const withAlpha = Buffer.from(
+			await sharp({ create: { width: 64, height: 48, channels: 4, background: "#3070c080" } })
+				.webp()
+				.toBuffer(),
+		);
+		expect(withAlpha.subarray(12, 16).toString()).toBe("VP8X");
+		expect(await codeOf(withAlpha, "image/webp", { decoder: inProcessDecoder })).toBe("OK");
+		withAlpha[20] |= 0x02;
+		expect(await codeOf(withAlpha, "image/webp", { decoder: forbiddenDecoder() })).toBe("ANIMATED");
+	});
+
+	it("rejects a decoder that finds several frames the header did not declare", async () => {
+		const { png } = await stills();
+		const multi: FullImageDecoder = {
+			decode: async () => ({ format: "png", width: 64, height: 48, frames: 3 }),
+		};
+		expect(await codeOf(png, "image/png", { decoder: multi })).toBe("ANIMATED");
+	});
+});
+
+describe("decoder limits and admission", () => {
+	it("terminates a decode that exceeds its wall time and leaves no process behind", async () => {
+		const bytes = await noisy(64, 48, "png");
+		let pid: number | undefined;
+		const decoder = createSharpChildDecoder({
+			onSpawn: (value) => {
+				pid = value;
+			},
+		});
+		const started = Date.now();
+		expect(await codeOf(bytes, "image/png", { decoder, limits: { wallTimeMs: 1 } })).toBe(
+			"DECODE_TIMEOUT",
+		);
+		expect(Date.now() - started).toBeLessThan(2000);
+		expect(pid).toBeTypeOf("number");
+		await vi.waitFor(() => expect(() => process.kill(pid!, 0)).toThrow(/ESRCH/));
+	});
+
+	it("kills a decoder that hangs, not merely one that finishes late", async () => {
+		const directory = await mkdtemp(join(tmpdir(), "emdash-hang-"));
+		try {
+			const stub = join(directory, "sharp.mjs");
+			// A sharp stand-in whose metadata never resolves: only a kill can end this decode.
+			await writeFile(
+				stub,
+				"const hang = () => new Promise(() => setInterval(() => {}, 1000));\nexport default Object.assign(() => ({ metadata: hang, stats: hang }), { cache() {} });\n",
+			);
+			let pid: number | undefined;
+			const decoder = createSharpChildDecoder({
+				sharpPath: stub,
+				onSpawn: (value) => {
+					pid = value;
+				},
+			});
+			const { png } = await stills();
+			const started = Date.now();
+			expect(await codeOf(png, "image/png", { decoder, limits: { wallTimeMs: 300 } })).toBe(
+				"DECODE_TIMEOUT",
+			);
+			expect(Date.now() - started).toBeLessThan(3000);
+			await vi.waitFor(() => expect(() => process.kill(pid!, 0)).toThrow(/ESRCH/), {
+				timeout: 2000,
+			});
+		} finally {
+			await rm(directory, { recursive: true, force: true });
+		}
+	});
+
+	it("reports an unavailable decoder instead of accepting unvalidated output", async () => {
+		const { png } = await stills();
+		const missing = createSharpChildDecoder({ sharpPath: "/nonexistent/sharp/index.js" });
+		expect(await codeOf(png, "image/png", { decoder: missing })).toBe("DECODER_CRASHED");
+		const unavailable: FullImageDecoder = {
+			decode: async () => {
+				throw new ImageDecodeError("DECODER_UNAVAILABLE", "none");
+			},
+		};
+		expect(await codeOf(png, "image/png", { decoder: unavailable })).toBe("DECODER_UNAVAILABLE");
+	});
+
+	it("reports a crashed decoder as such", async () => {
+		const { png } = await stills();
+		const crashing: FullImageDecoder = {
+			decode: async () => {
+				throw new ImageDecodeError("DECODER_CRASHED", "x");
+			},
+		};
+		expect(await codeOf(png, "image/png", { decoder: crashing })).toBe("DECODER_CRASHED");
+	});
+
+	it("refuses work beyond the in-flight pixel budget as retryable, and releases the budget afterwards", async () => {
+		const { png } = await stills();
+		const pixels = 64 * 48;
+		const admission = createDecodeAdmission(pixels);
+		const gate = Promise.withResolvers<void>();
+		const slow: FullImageDecoder = {
+			decode: async (bytes, request) => {
+				await gate.promise;
+				return inProcessDecoder.decode(bytes, request);
+			},
+		};
+		const validator = createOutputValidator({
+			decoder: slow,
+			admission,
+			limits: { maxPixels: pixels, maxInFlightPixels: pixels },
+		});
+		const first = validator.validate(png, source("image/png"));
+		await vi.waitFor(() => expect(admission.inFlightPixels()).toBe(pixels));
+		expect(await validator.validate(png, source("image/png"))).toMatchObject({
+			ok: false,
+			code: "BUSY",
+			retryable: true,
+		});
+		gate.resolve();
+		expect((await first).ok).toBe(true);
+		expect(admission.inFlightPixels()).toBe(0);
+		expect((await validator.validate(png, source("image/png"))).ok).toBe(true);
+	});
+
+	it("releases the budget when the decoder fails or throws unexpectedly", async () => {
+		const { png } = await stills();
+		const admission = createDecodeAdmission(64 * 48);
+		const failing: FullImageDecoder = {
+			decode: async () => {
+				throw new ImageDecodeError("CORRUPT", "x");
+			},
+		};
+		const exploding: FullImageDecoder = {
+			decode: async () => {
+				throw new TypeError("bug");
+			},
+		};
+		const limits = { maxPixels: 64 * 48, maxInFlightPixels: 64 * 48 };
+		expect(
+			await createOutputValidator({ decoder: failing, admission, limits }).validate(
+				png,
+				source("image/png"),
+			),
+		).toMatchObject({ code: "CORRUPT" });
+		await expect(
+			createOutputValidator({ decoder: exploding, admission, limits }).validate(
+				png,
+				source("image/png"),
+			),
+		).rejects.toThrow(TypeError);
+		expect(admission.inFlightPixels()).toBe(0);
+	});
+
+	it("rejects inconsistent limits", () => {
+		expect(() =>
+			createOutputValidator({
+				decoder: inProcessDecoder,
+				limits: { maxPixels: 100, maxInFlightPixels: 99 },
+			}),
+		).toThrow(RangeError);
+		expect(() =>
+			createOutputValidator({ decoder: inProcessDecoder, limits: { maxBytes: 0 } }),
+		).toThrow(RangeError);
+		expect(() =>
+			createOutputValidator({ decoder: inProcessDecoder, limits: { wallTimeMs: 1.5 } }),
+		).toThrow(RangeError);
+	});
+});
+
+describe("admission", () => {
+	it("admits only while the sum fits, and release is idempotent", () => {
+		const admission = createDecodeAdmission(100);
+		const a = admission.tryAcquire(60)!;
+		expect(admission.tryAcquire(41)).toBeNull();
+		const b = admission.tryAcquire(40)!;
+		expect(admission.inFlightPixels()).toBe(100);
+		a();
+		a();
+		expect(admission.inFlightPixels()).toBe(40);
+		b();
+		expect(admission.inFlightPixels()).toBe(0);
+		expect(admission.tryAcquire(0)).toBeNull();
+		expect(admission.tryAcquire(-5)).toBeNull();
+		expect(admission.tryAcquire(Number.NaN)).toBeNull();
+	});
+});
