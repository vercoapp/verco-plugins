+	limits: { maxBytes: 1024 * 1024, maxPixels: 1_000_000 },
+};
+
+describe("native safe-media access", () => {
+	let root: string;
+	let db: Kysely<Database>;
+	let active: LocalStorage;
+	let host: SafeMediaPluginHost;
+	let originalBytes: Uint8Array;
+	let optimized: Uint8Array;
+	let mediaId: string;
+
+	const factory = (withSafeMedia = true) =>
+		new PluginContextFactory({
+			db,
+			storage: active,
+			...(withSafeMedia && { safeMedia: host }),
+		});
+	const native = (capabilities: Parameters<typeof definePlugin>[0]["capabilities"]) =>
+		definePlugin({ id: "native-optimizer", version: "1.0.0", capabilities });
+	const sandboxedInProcess = (capabilities: string[]) =>
+		adaptSandboxEntry(
+			{ hooks: {}, routes: {} },
+			{
+				id: "sandboxed-optimizer",
+				version: "1.0.0",
+				entrypoint: "sandboxed-optimizer",
+				format: "standard",
+				capabilities,
+			},
+		);
+
+	const count = async (
+		table: "_emdash_media_revisions" | "_emdash_media_originals" | "_emdash_media_operations",
+	) =>
+		Number(
+			(
+				await db
+					.selectFrom(table)
+					.select((eb) => eb.fn.countAll().as("n"))
+					.executeTakeFirstOrThrow()
+			).n,
+		);
+	const snapshot = async () => ({
+		revisions: await count("_emdash_media_revisions"),
+		originals: await count("_emdash_media_originals"),
+		operations: await count("_emdash_media_operations"),
+		uploads: (await readdir(join(root, "uploads"))).toSorted(),
+		private: (await readdir(join(root, "private")).catch((): string[] => [])).toSorted(),
+		media: await db.selectFrom("media").selectAll().where("id", "=", mediaId).executeTakeFirst(),
+		served: sha(await readFile(join(root, "uploads", KEY))),
+	});
+
+	beforeEach(async () => {
+		root = await mkdtemp(join(tmpdir(), "emdash-native-access-"));
+		await mkdir(join(root, "uploads"), { recursive: true });
+		db = new Kysely<Database>({
+			dialect: new SqliteDialect({ database: openNodeSqliteDatabase(join(root, "site.db")) }),
+		});
+		await runMigrations(db);
+		active = new LocalStorage({ directory: join(root, "uploads"), baseUrl: "/media" });
+		originalBytes = await noisy(64, 48, "png");
+		optimized = await solid(64, 48, "#2060e0").png().toBuffer();
+		await active.upload({ key: KEY, body: originalBytes, contentType: "image/png" });
+		const media = await new MediaRepository(db).create({
+			filename: "photo.png",
+			mimeType: "image/png",
+			size: originalBytes.byteLength,
+			width: 64,
+			height: 48,
+			storageKey: KEY,
+			contentHash: await computeContentHash(originalBytes),
+			status: "ready",
+		});
+		mediaId = media.id;
+		host = {
+			service: createMediaReplacementService({
+				db,
+				storage: active,
