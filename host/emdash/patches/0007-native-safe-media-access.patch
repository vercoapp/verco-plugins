index 0000000000000000000000000000000000000000..6166b449f4376b441eaba855f04d6a4dc3261c58
--- /dev/null
+++ b/packages/core/tests/integration/runtime/plugin-safe-media.test.ts
@@ -0,0 +1,153 @@
+/**
+ * `ctx.media.safe` reaches native plugin routes through the runtime's own
+ * wiring when `safeMedia` is configured, and nothing else receives it.
+ */
+
+import { randomUUID } from "node:crypto";
+import { mkdir, mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { SqliteDialect } from "kysely";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { NodeSqliteCompatDatabase as Database } from "#node-sqlite";
+
+import { MediaRepository } from "../../../src/database/repositories/media.js";
+import { EmDashRuntime } from "../../../src/emdash-runtime.js";
+import type { RuntimeDependencies } from "../../../src/emdash-runtime.js";
+import { adaptSandboxEntry } from "../../../src/plugins/adapt-sandbox-entry.js";
+import { definePlugin } from "../../../src/plugins/define-plugin.js";
+import type { PluginContext } from "../../../src/plugins/types.js";
+import { LocalStorage } from "../../../src/storage/local.js";
+
+const probe = {
+	handler: async (ctx: PluginContext & { input: unknown }) => {
+		const safe = ctx.media?.safe;
+		if (!safe) return { access: false };
+		const { mediaId } = ctx.input as { mediaId: string };
+		return { access: true, support: await safe.support(), revision: await safe.revision(mediaId) };
+	},
+};
+
+describe("EmDashRuntime safe-media access for plugin routes", () => {
+	let root: string;
+	let runtime: EmDashRuntime | undefined;
+
+	beforeEach(async () => {
+		root = await mkdtemp(join(tmpdir(), "emdash-runtime-safe-media-"));
+		await mkdir(join(root, "uploads"), { recursive: true });
+	});
+
+	afterEach(async () => {
+		await runtime?.stopCron();
+		runtime = undefined;
+		await rm(root, { recursive: true, force: true });
+	});
+
+	async function start(safeMedia: boolean) {
+		const storage = new LocalStorage({ directory: join(root, "uploads"), baseUrl: "/media" });
+		const deps: RuntimeDependencies = {
+			config: {
+				// The runtime caches its database per entrypoint; only the safeMedia case needs the real name.
+				database: {
+					entrypoint: safeMedia ? "emdash/db/sqlite" : `test-safe-media-${randomUUID()}`,
+					config: {},
+					type: "sqlite",
+				},
+				storage: {
+					entrypoint: "emdash/storage/local",
+					config: { directory: join(root, "uploads") },
+				},
+				...(safeMedia && { safeMedia: { privateDirectory: join(root, "private") } }),
+			},
+			plugins: [
+				definePlugin({
+					id: "native-replacer",
+					version: "1.0.0",
+					capabilities: ["media:bytes:replace"],
+					routes: { probe },
+				}),
+				definePlugin({
+					id: "native-reader",
+					version: "1.0.0",
+					capabilities: ["media:read", "media:bytes:read"],
+					routes: { probe },
+				}),
+				adaptSandboxEntry(
+					{
+						routes: {
+							probe: (routeCtx, ctx) => probe.handler({ ...ctx, input: routeCtx.input } as never),
+						},
+					},
+					{
+						id: "sandboxed-reader",
+						version: "1.0.0",
+						entrypoint: "sandboxed-reader",
+						format: "standard",
+						capabilities: ["media:read", "media:bytes:read", "media:write"],
+					},
+				),
+			],
+			createDialect: () => new SqliteDialect({ database: new Database(join(root, "site.db")) }),
+			createStorage: () => storage,
+			sandboxEnabled: false,
+			sandboxedPluginEntries: [],
+			createSandboxRunner: null,
+		};
+		runtime = await EmDashRuntime.create(deps);
+		await storage.upload({
+			key: "01HZRUNTIME.png",
+			body: new Uint8Array([1]),
+			contentType: "image/png",
+		});
+		const media = await new MediaRepository(runtime.db).create({
+			filename: "photo.png",
+			mimeType: "image/png",
+			size: 1,
+			width: 2,
+			height: 2,
+			storageKey: "01HZRUNTIME.png",
+			status: "ready",
+		});
+		return media.id;
+	}
+
+	async function call(pluginId: string, mediaId: string) {
+		const result = await runtime!.handlePluginApiRoute(
+			pluginId,
+			"POST",
+			"/probe",
+			new Request(`http://test.local/_emdash/api/plugin/${pluginId}/probe`, {
+				method: "POST",
+				headers: { "content-type": "application/json" },
+				body: JSON.stringify({ mediaId }),
+			}),
+		);
+		expect(result.success).toBe(true);
+		return result.data as { access: boolean; support?: unknown; revision?: unknown };
+	}
+
+	it("gives the native plugin with the capability support discovery from the configured host", async () => {
+		const mediaId = await start(true);
+		const result = await call("native-replacer", mediaId);
+		expect(result).toMatchObject({
+			access: true,
+			support: {
+				protocol: 1,
+				profile: { runtime: "node", database: "sqlite", storage: "local", locks: "in-process" },
+				geometry: "unchanged",
+			},
+			revision: { mediaId, mimeType: "image/png", width: 2, height: 2 },
+		});
+		await expect(call("native-reader", mediaId)).resolves.toEqual({ access: false });
+		await expect(call("sandboxed-reader", mediaId)).resolves.toEqual({ access: false });
+	});
+
+	it("gives no plugin access when safeMedia is not configured", async () => {
+		const mediaId = await start(false);
+		for (const pluginId of ["native-replacer", "native-reader", "sandboxed-reader"]) {
+			await expect(call(pluginId, mediaId)).resolves.toEqual({ access: false });
+		}
+	});
+});
