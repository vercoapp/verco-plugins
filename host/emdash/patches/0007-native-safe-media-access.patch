diff --git a/packages/core/src/plugins/native-capabilities.ts b/packages/core/src/plugins/native-capabilities.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9cefa6d7304798f400fb2bc40a3819a8442ae2d1
--- /dev/null
+++ b/packages/core/src/plugins/native-capabilities.ts
@@ -0,0 +1,45 @@
+/**
+ * Capabilities only native plugins may declare.
+ *
+ * They are not part of the shared manifest vocabulary in
+ * `@emdash-cms/plugin-types`, so registry and marketplace manifests, the
+ * sandboxed-format adapter and the plugin CLI all reject them as unknown.
+ * `definePlugin()` records them on `ResolvedPlugin.nativeCapabilities`, which
+ * no sandboxed loading path sets.
+ */
+
+/**
+ * `media:bytes:replace` grants `ctx.media.safe` on hosts with `safeMedia`:
+ * revision-fenced, same-geometry replacement and restore of retained originals.
+ */
+export const NATIVE_PLUGIN_CAPABILITIES = ["media:bytes:replace"] as const;
+
+export type NativePluginCapability = (typeof NATIVE_PLUGIN_CAPABILITIES)[number];
+
+export function isNativePluginCapability(value: string): value is NativePluginCapability {
+	return NATIVE_PLUGIN_CAPABILITIES.some((capability) => capability === value);
+}
+
+/**
+ * Refuse configuration that declares a native-only capability for a plugin
+ * that runs in the sandboxed format, whether in a sandbox or in-process.
+ */
+export function assertNoSandboxedNativeCapabilities(
+	descriptors: ReadonlyArray<{
+		id: string;
+		format?: "standard" | "native";
+		capabilities?: readonly string[];
+	}>,
+	sandboxed: boolean,
+): void {
+	for (const descriptor of descriptors) {
+		if (!sandboxed && descriptor.format !== "standard") continue;
+		const declared = (descriptor.capabilities ?? []).filter(isNativePluginCapability);
+		if (declared.length > 0) {
+			throw new Error(
+				`Plugin "${descriptor.id}" declares ${declared.join(", ")}, which only native plugins ` +
+					"may declare. Sandboxed-format plugins cannot receive this access, in a sandbox or in-process.",
+			);
+		}
+	}
+}
