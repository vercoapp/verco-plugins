+/**
+ * Safe media operations for native plugins (`ctx.media.safe`).
+ *
+ * A narrow surface over the replacement service: support discovery, the active
+ * revision, same-geometry replacement, restore of retained originals and
+ * operation status. Operations are attributed to the plugin, and a plugin can
+ * neither read nor reuse another caller's operation records.
+ *
+ * Only types are imported from the service so this module stays free of
+ * Node-only dependencies.
+ */
+
+import type {
+	MediaReplacementService,
+	PublishedReceipt,
+	RejectedReceipt,
+	ReplaceResult,
+	RestorableOriginal,
+} from "./replacement-service.js";
+
+/** Version of this surface. A caller must refuse a protocol it does not know. */
+export const SAFE_MEDIA_PROTOCOL = 1;
+
+/** The host profile as configured, so a caller can decide whether it is qualified. */
+export interface SafeMediaHostProfile {
+	runtime: "node" | "bun" | "deno" | "workerd" | "unknown";
+	database: "sqlite" | "libsql" | "postgres" | "d1" | "unknown";
+	storage: "local" | "s3" | "r2" | "unknown";
+	/** Operation locks cover one process; work of another process is protected only by a grace period. */
+	locks: "in-process";
+}
+
+export interface SafeMediaSupport {
+	protocol: typeof SAFE_MEDIA_PROTOCOL;
+	profile: SafeMediaHostProfile;
+	/** Formats that may be replaced, each only by the same format. */
+	formats: readonly ("jpeg" | "png" | "webp")[];
+	/** Replacement through this surface never changes dimensions. */
+	geometry: "unchanged";
+	limits: { maxBytes: number; maxPixels: number };
+}
+
+/** The active revision of a ready media item; pass `revisionId` as `expectedRevisionId`. */
+export interface SafeMediaRevision {
+	mediaId: string;
+	revisionId: string;
+	mimeType: string;
+	size: number | null;
+	width: number | null;
+	height: number | null;
+	/** Null until the host has digested these bytes (on the first operation that retains them). */
+	sha256: string | null;
+}
+
+export interface SafeMediaReplaceRequest {
+	mediaId: string;
+	/** Chosen by the caller; repeating the same request with it returns the stored outcome. */
+	operationId: string;
+	expectedRevisionId: string;
+	bytes: Uint8Array;
+	/** SHA-256 of `bytes`, checked by the host before anything is staged. */
+	expectedSha256?: string;
+}
+
+export interface SafeMediaRestoreRequest {
+	mediaId: string;
+	operationId: string;
+	expectedRevisionId: string;
+	/** Defaults to the original retained by the operation that published `expectedRevisionId`. */
+	originalSha256?: string;
+}
+
+export interface SafeMediaOperationStatus {
+	state: string;
+	kind: string;
+	receipt: PublishedReceipt | RejectedReceipt | null;
+}
+
+export type SafeMediaResult = ReplaceResult;
+export type SafeMediaRestorableOriginal = RestorableOriginal;
+
+export interface SafeMediaAccess {
+	support(): Promise<SafeMediaSupport>;
+	/** Null when the media item does not exist or is not ready. */
+	revision(mediaId: string): Promise<SafeMediaRevision | null>;
+	/** Publish same-format, same-dimension bytes against `expectedRevisionId`. */
+	replace(request: SafeMediaReplaceRequest): Promise<SafeMediaResult>;
+	/** Publish a retained original of this media item against `expectedRevisionId`. */
+	restore(request: SafeMediaRestoreRequest): Promise<SafeMediaResult>;
+	listRestorableOriginals(mediaId: string): Promise<SafeMediaRestorableOriginal[]>;
+	/** Status and receipt of an operation this plugin started; null for unknown or foreign IDs. */
+	operation(mediaId: string, operationId: string): Promise<SafeMediaOperationStatus | null>;
+}
+
+/** What the host provides to build the plugin surface. */
+export interface SafeMediaPluginHost {
+	service: MediaReplacementService;
+	support: SafeMediaSupport;
+}
+
+export function safeMediaOperationOwner(pluginId: string): string {
+	return `plugin:${pluginId}`;
+}
+
+const FOREIGN_OPERATION: SafeMediaResult = {
+	ok: false,
+	code: "CONFLICTING_OPERATION",
+	message: "This operation ID was already used by another caller.",
+	retryable: false,
+};
+
+export function createSafeMediaPluginAccess(
+	host: SafeMediaPluginHost,
+	pluginId: string,
+): SafeMediaAccess {
+	const { service } = host;
+	const owner = safeMediaOperationOwner(pluginId);
+	const support = Object.freeze({
+		...host.support,
+		profile: Object.freeze({ ...host.support.profile }),
+		formats: Object.freeze([...host.support.formats]),
+		limits: Object.freeze({ ...host.support.limits }),
+	});
+
+	/** True when the ID is already recorded for this media item by a different caller. */
+	async function foreign(mediaId: string, operationId: string): Promise<boolean> {
+		const existing = await service.getOperation(mediaId, operationId);
+		return existing !== null && existing.createdBy !== owner;
+	}
+
+	return {
+		async support() {
+			return support;
+		},
+
+		async revision(mediaId) {
+			const revision = await service.getSourceRevision(mediaId);
+			if (!revision) return null;
+			return {
+				mediaId: revision.media_id,
+				revisionId: revision.id,
+				mimeType: revision.mime_type,
+				size: revision.size,
+				width: revision.width,
+				height: revision.height,
+				sha256: revision.sha256,
+			};
+		},
+
+		async replace(request) {
+			if (await foreign(request.mediaId, request.operationId)) return FOREIGN_OPERATION;
+			// Built field by field: geometry and attribution are the host's, never the caller's.
+			return service.replace({
+				mediaId: request.mediaId,
+				operationId: request.operationId,
+				expectedRevisionId: request.expectedRevisionId,
+				bytes: request.bytes,
+				expectedSha256: request.expectedSha256,
+				geometry: "unchanged",
+				createdBy: owner,
+			});
+		},
+
+		async restore(request) {
+			if (await foreign(request.mediaId, request.operationId)) return FOREIGN_OPERATION;
+			return service.restore({
+				mediaId: request.mediaId,
+				operationId: request.operationId,
+				expectedRevisionId: request.expectedRevisionId,
+				originalSha256: request.originalSha256,
+				createdBy: owner,
+			});
+		},
+
+		listRestorableOriginals(mediaId) {
+			return service.listRestorableOriginals(mediaId);
+		},
+
+		async operation(mediaId, operationId) {
+			const status = await service.getOperation(mediaId, operationId);
+			if (!status || status.createdBy !== owner) return null;
+			return { state: status.state, kind: status.kind, receipt: status.receipt };
+		},
+	};
+}
