+
+import {
+	handleMediaDelete,
+	handleMediaGet,
+	handleMediaReplaceMetadata,
+} from "../../../../src/api/handlers/media.js";
+import { PUT as replaceRoute } from "../../../../src/astro/routes/api/media/[id]/replace.js";
+import { GET as getAsset } from "../../../../src/astro/routes/api/media/asset/[id]/[filename].js";
+import { GET as getFile } from "../../../../src/astro/routes/api/media/file/[...key].js";
+import { runMigrations } from "../../../../src/database/migrations/runner.js";
+import { MediaOperationsRepository } from "../../../../src/database/repositories/media-operations.js";
+import { MediaRepository } from "../../../../src/database/repositories/media.js";
+import type { Database } from "../../../../src/database/types.js";
+import { openNodeSqliteDatabase } from "../../../../src/db/node-sqlite-compat.js";
+import { PrivateStorageConfigError } from "../../../../src/media/safe/private-local.js";
+import { createSafeMedia } from "../../../../src/media/safe/runtime.js";
+import { readPluginMediaBytes } from "../../../../src/plugins/media.js";
+import { LocalStorage } from "../../../../src/storage/local.js";
+import { hashStoredObject } from "../../../../src/transfer/export/media.js";
+import { computeContentHash } from "../../../../src/utils/hash.js";
+import { noisy, solid } from "./output-fixtures.js";
+
+const sha = (bytes: Uint8Array) => createHash("sha256").update(bytes).digest("hex");
+const KEY = "01HZINTEGRATION.png";
+const ADMIN = { id: "admin-1", role: 50 };
+
+describe("safe media integration", () => {
+	let root: string;
+	let db: Kysely<Database>;
+	let raw: LocalStorage;
+	let safe: ReturnType<typeof createSafeMedia>;
+	let originalBytes: Uint8Array;
+	let mediaId: string;
+
+	const open = () =>
+		new Kysely<Database>({
+			dialect: new SqliteDialect({ database: openNodeSqliteDatabase(join(root, "site.db")) }),
+		});
+	const descriptor = () => ({
+		entrypoint: "emdash/storage/local",
+		config: { directory: join(root, "uploads"), baseUrl: "/_emdash/api/media/file" },
+	});
+	const make = (overrides: Partial<Parameters<typeof createSafeMedia>[0]> = {}) =>
+		createSafeMedia({
+			config: { privateDirectory: join(root, "private") },
+			storageDescriptor: descriptor(),
+			rawStorage: raw,
+			db,
+			resolveDb: () => db,
+			...overrides,
+		});
+
+	function locals(overrides: Record<string, unknown> = {}) {
+		return {
+			emdash: {
+				storage: safe.storage,
+				mediaReplacement: safe.service,
+				db,
+				config: { maxUploadSize: 10 * 1024 * 1024 },
+				handleMediaGet: (id: string) => handleMediaGet(db, id),
+				handleMediaReplaceMetadata: (
+					id: string,
+					key: string,
+					input: { size: number; width: number; height: number; contentHash: string },
+				) => handleMediaReplaceMetadata(db, id, key, input),
+				...overrides,
+			},
+			user: ADMIN,
+		};
+	}
+
+	async function putReplacement(
+		bytes: Uint8Array,
+		type = "image/png",
+		extra: Record<string, unknown> = {},
+	) {
+		const form = new FormData();
+		form.set("file", new File([bytes], "new.png", { type }));
+		form.set("width", "1");
+		form.set("height", "1");
+		const response = await replaceRoute({
+			params: { id: mediaId },
+			request: new Request("https://example.com", {
+				method: "PUT",
+				body: form,
+				headers: { "X-EmDash-Request": "1" },
+			}),
+			locals: locals(extra),
+		} as never);
+		return {
+			status: response.status,
+			body: (await response.json()) as {
+				data?: { item: Record<string, unknown> };
+				error?: { code: string };
+			},
+		};
+	}
+
+	const fetchKey = async (storageLocals = locals(), key = KEY) => {
+		const response = await getFile({
+			params: { key },
+			locals: storageLocals,
+			request: new Request("https://example.com"),
+		} as never);
+		return {
+			status: response.status,
+			bytes: response.status === 200 ? new Uint8Array(await response.arrayBuffer()) : null,
+		};
+	};
+	const row = () =>
+		db.selectFrom("media").selectAll().where("id", "=", mediaId).executeTakeFirstOrThrow();
+	const count = async (
+		table: "_emdash_media_revisions" | "_emdash_media_originals" | "_emdash_media_operations",
+	) =>
+		Number(
+			(
+				await db
+					.selectFrom(table)
+					.select((eb) => eb.fn.countAll().as("n"))
+					.executeTakeFirstOrThrow()
+			).n,
+		);
+
+	beforeEach(async () => {
+		root = await mkdtemp(join(tmpdir(), "emdash-safe-media-"));
+		await mkdir(join(root, "uploads"), { recursive: true });
+		db = open();
+		await runMigrations(db);
+		raw = new LocalStorage({
+			directory: join(root, "uploads"),
+			baseUrl: "/_emdash/api/media/file",
+		});
+		originalBytes = await noisy(64, 48, "png");
+		await raw.upload({ key: KEY, body: originalBytes, contentType: "image/png" });
+		const media = await new MediaRepository(db).create({
+			filename: "photo.png",
+			mimeType: "image/png",
+			size: originalBytes.byteLength,
+			width: 64,
+			height: 48,
+			alt: "Alt",
+			caption: "Caption",
+			storageKey: KEY,
+			contentHash: await computeContentHash(originalBytes),
+			status: "ready",
+			authorId: ADMIN.id,
+		});
+		mediaId = media.id;
+		await new MediaRepository(db).update(mediaId, { focalX: 0.25, focalY: 0.75 });
+		safe = make();
+	});
+
+	afterEach(async () => {
+		await db.destroy();
+		await rm(root, { recursive: true, force: true });
+	});
+
+	describe("configuration", () => {
+		it("refuses profiles it cannot make safe, at startup", () => {
+			expect(() => make({ config: { privateDirectory: "" } })).toThrow(PrivateStorageConfigError);
+			expect(() => make({ rawStorage: null })).toThrow(/local filesystem/);
+			expect(() =>
+				make({ storageDescriptor: { entrypoint: "emdash/storage/s3", config: {} } }),
+			).toThrow(/local filesystem/);
+			expect(() =>
+				make({ config: { privateDirectory: join(root, "uploads", "private") } }),
+			).toThrow(PrivateStorageConfigError);
+			expect(() => make({ config: { privateDirectory: root } })).toThrow(PrivateStorageConfigError);
+			expect(() =>
+				make({ config: { privateDirectory: join(process.cwd(), "public", "x") } }),
+			).toThrow(PrivateStorageConfigError);
+		});
+
+		it("passes ordinary storage operations through unchanged", async () => {
+			await safe.storage.upload({
+				key: "other.png",
+				body: new Uint8Array([1, 2, 3]),
+				contentType: "image/png",
+			});
+			expect(await safe.storage.exists("other.png")).toBe(true);
+			expect((await safe.storage.list()).files.map((file) => file.key).toSorted()).toEqual([
+				KEY,
+				"other.png",
+			]);
+			expect(safe.storage.getPublicUrl("other.png")).toBe(raw.getPublicUrl("other.png"));
+			await safe.storage.delete("other.png");
+			expect(await safe.storage.exists("other.png")).toBe(false);
+			expect(await safe.storage.exists("backups/never-resolved-through-the-database")).toBe(false);
+		});
+	});
+
+	describe("manual replacement through the route", () => {
+		it("replaces with new dimensions: identity kept, bytes derived, focal point reset, previous bytes retained", async () => {
+			const bigger = await solid(80, 60, "#2060e0").png().toBuffer();
+			const before = await row();
+			const result = await putReplacement(bigger);
+			expect(result.status).toBe(200);
+			expect(result.body.data?.item).toMatchObject({
+				id: mediaId,
+				storageKey: KEY,
+				width: 80,
+				height: 60,
+				size: bigger.byteLength,
+				url: `/_emdash/api/media/file/${KEY}`,
+			});
+			const after = await row();
+			expect([
+				after.id,
+				after.filename,
+				after.alt,
+				after.caption,
+				after.created_at,
+				after.author_id,
+			]).toEqual([
+				before.id,
+				before.filename,
+				before.alt,
+				before.caption,
+				before.created_at,
+				before.author_id,
+			]);
+			expect([after.focal_x, after.focal_y]).toEqual([null, null]);
+			expect((await fetchKey()).bytes).toEqual(new Uint8Array(bigger));
+			expect(await readFile(join(root, "private", "media-originals", sha(originalBytes)))).toEqual(
+				Buffer.from(originalBytes),
+			);
+			expect(await readFile(join(root, "uploads", KEY))).toEqual(Buffer.from(originalBytes));
+		});
+
+		it("keeps the focal point when the new image has the same dimensions", async () => {
+			const same = await solid(64, 48, "#2060e0").png().toBuffer();
+			expect((await putReplacement(same)).status).toBe(200);
+			const after = await row();
+			expect([after.focal_x, after.focal_y]).toEqual([0.25, 0.75]);
+		});
+
+		it("ignores client-supplied dimensions", async () => {
+			const result = await putReplacement(await solid(80, 60).png().toBuffer());
+			expect(result.body.data?.item).toMatchObject({ width: 80, height: 60 });
+		});
+
+		it("rejects invalid images with a client error and leaves everything unchanged", async () => {
+			const jpeg = await solid(64, 48).jpeg().toBuffer();
+			const truncated = (await noisy(64, 48, "png")).subarray(0, 100);
+			const bomb = await solid(9000, 9000).png({ compressionLevel: 9 }).toBuffer();
+			for (const [bytes, expected] of [
+				[jpeg, "WRONG_FORMAT"],
+				[truncated, "UNDECODABLE"],
+				[bomb, "TOO_MANY_PIXELS"],
+			] as const) {
