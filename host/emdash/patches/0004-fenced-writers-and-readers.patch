@@ -0,0 +1,156 @@
+/**
+ * Host wiring for safe media operations: the revision-aware storage that every
+ * reader of media bytes goes through, and the replacement service.
+ *
+ * The first supported profile is local filesystem storage with SQLite on Node.
+ * Enabling it is explicit (`safeMedia.privateDirectory`), and a misconfigured
+ * profile fails at startup instead of falling back to unsafe behavior.
+ */
+
+import { join, resolve } from "node:path";
+
+import type { Kysely } from "kysely";
+
+import type { Database } from "../../database/types.js";
+import type {
+	DownloadResult,
+	ListOptions,
+	ListResult,
+	SignedUploadOptions,
+	SignedUploadUrl,
+	Storage,
+	UploadResult,
+} from "../../storage/types.js";
+import { createDecodeAdmission } from "./admission.js";
+import { resolveDecodeLimits } from "./decode-limits.js";
+import { createLocalPrivateStorage, PrivateStorageConfigError } from "./private-local.js";
+import { createPrivateOriginalStore } from "./private-originals.js";
+import type { MediaReplacementService, PublishedReceipt } from "./replacement-service.js";
+import { createMediaReplacementService } from "./replacement-service.js";
+import { resolveActiveObjectKey } from "./resolve-object.js";
+import { createSharpChildDecoder } from "./sharp-child-decoder.js";
+import { createOutputValidator } from "./validate-output.js";
+
+export interface SafeMediaConfig {
+	/** Directory for retained originals. Must be separate from the public storage and the `public` directory. */
+	privateDirectory: string;
+}
+
+const LOCAL_STORAGE_ENTRYPOINT = "emdash/storage/local";
+/** Stable media keys are flat `{ulid}{ext}`; anything with a slash is not a media row's key. */
+const STABLE_KEY = /^[A-Za-z0-9._-]+$/;
+
+/**
+ * Serves a stable key from the media's active revision. Reads of unmanaged keys
+ * and non-media keys fall through to the wrapped storage, and every other
+ * operation is forwarded unchanged.
+ */
+class RevisionAwareStorage implements Storage {
+	constructor(
+		private readonly inner: Storage,
+		private readonly resolveDb: () => Kysely<Database>,
+	) {
+		const origin = inner.getClientUploadOrigin?.bind(inner);
+		if (origin) this.getClientUploadOrigin = () => origin();
+	}
+
+	private async objectKey(key: string): Promise<string> {
+		return STABLE_KEY.test(key) ? resolveActiveObjectKey(this.resolveDb(), key) : key;
+	}
+
+	async download(key: string): Promise<DownloadResult> {
+		return this.inner.download(await this.objectKey(key));
+	}
+
+	async exists(key: string): Promise<boolean> {
+		return this.inner.exists(await this.objectKey(key));
+	}
+
+	upload(options: Parameters<Storage["upload"]>[0]): Promise<UploadResult> {
+		return this.inner.upload(options);
+	}
+
+	delete(key: string): Promise<void> {
+		return this.inner.delete(key);
+	}
+
+	list(options?: ListOptions): Promise<ListResult> {
+		return this.inner.list(options);
+	}
+
+	getSignedUploadUrl(options: SignedUploadOptions): Promise<SignedUploadUrl> {
+		return this.inner.getSignedUploadUrl(options);
+	}
+
+	getPublicUrl(key: string): string {
+		return this.inner.getPublicUrl(key);
+	}
+
+	// Present only when the wrapped storage has one, because callers test for its existence.
+	getClientUploadOrigin?: () => string;
+}
+
+export function createRevisionAwareStorage(
+	storage: Storage,
+	resolveDb: () => Kysely<Database>,
+): Storage {
+	return new RevisionAwareStorage(storage, resolveDb);
+}
+
+export interface CreateSafeMediaOptions {
+	config: SafeMediaConfig;
+	storageDescriptor: { entrypoint: string; config: unknown } | undefined;
+	/** The active storage, before any decoration. The service reads and writes this one. */
+	rawStorage: Storage | null;
+	db: Kysely<Database>;
+	resolveDb: () => Kysely<Database>;
+	maxUploadSize?: number;
+	onPublished?: (receipt: PublishedReceipt) => void;
+}
+
+export interface SafeMedia {
+	/** Storage for every reader; stable keys resolve to the active revision. */
+	storage: Storage;
+	service: MediaReplacementService;
+}
+
+export function createSafeMedia(options: CreateSafeMediaOptions): SafeMedia {
+	const { config, storageDescriptor, rawStorage } = options;
+	if (!config.privateDirectory) {
+		throw new PrivateStorageConfigError("safeMedia.privateDirectory is required");
+	}
+	if (!rawStorage || storageDescriptor?.entrypoint !== LOCAL_STORAGE_ENTRYPOINT) {
+		throw new PrivateStorageConfigError(
+			"safeMedia currently requires the local filesystem storage adapter",
+		);
+	}
+	const publicDirectories = [join(process.cwd(), "public")];
+	const storageConfig: unknown = storageDescriptor.config;
+	const directory: unknown =
+		typeof storageConfig === "object" && storageConfig !== null
+			? Reflect.get(storageConfig, "directory")
+			: undefined;
+	if (typeof directory === "string") publicDirectories.push(resolve(directory));
+
+	const originals = createPrivateOriginalStore(
+		createLocalPrivateStorage({ directory: config.privateDirectory, publicDirectories }),
+	);
