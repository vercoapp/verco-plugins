diff --git a/packages/core/tests/unit/media/safe/decoder-lifecycle.test.ts b/packages/core/tests/unit/media/safe/decoder-lifecycle.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8893964bcb652eeacfb4b635a72849f2c0152ad7
--- /dev/null
+++ b/packages/core/tests/unit/media/safe/decoder-lifecycle.test.ts
@@ -0,0 +1,111 @@
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import ts from "typescript";
+import { expect, it, vi } from "vitest";
+
+import { createSharpChildDecoder } from "../../../../src/media/safe/sharp-child-decoder.js";
+
+const request = { format: "png" as const, maxPixels: 100, timeoutMs: 10_000 };
+
+async function stop(pid: number | undefined) {
+	if (pid === undefined) return;
+	try {
+		process.kill(pid, "SIGKILL");
+	} catch (error) {
+		if ((error as NodeJS.ErrnoException).code !== "ESRCH") throw error;
+	}
+	await vi.waitFor(() => expect(() => process.kill(pid, 0)).toThrow(/ESRCH/), { timeout: 2000 });
+}
+
+it("reaps the decoder before reporting a timeout", async () => {
+	let pid: number | undefined;
+	try {
+		const decoder = createSharpChildDecoder({
+			onSpawn: (value) => {
+				pid = value;
+			},
+		});
+		await expect(
+			decoder.decode(new Uint8Array(), { ...request, timeoutMs: 1 }),
+		).rejects.toMatchObject({ code: "DECODE_TIMEOUT" });
+		expect(pid).toBeTypeOf("number");
+		expect(() => process.kill(pid!, 0)).toThrow(/ESRCH/);
+	} finally {
+		await stop(pid);
+	}
+});
+
+it("reaps the decoder if the spawn observer throws", async () => {
+	let pid: number | undefined;
+	const failure = new Error("observer failed");
+	try {
+		const decoder = createSharpChildDecoder({
+			onSpawn: (value) => {
+				pid = value;
+				throw failure;
+			},
+		});
+		await expect(decoder.decode(new Uint8Array(), request)).rejects.toBe(failure);
+		expect(() => process.kill(pid!, 0)).toThrow(/ESRCH/);
+	} finally {
+		await stop(pid);
+	}
+});
+
+it("exits a hung decoder when its parent is killed", async () => {
+	const directory = await mkdtemp(join(tmpdir(), "emdash-decoder-lifecycle-"));
+	let pid: number | undefined;
+	let parent: ReturnType<typeof spawn> | undefined;
+	try {
+		for (const name of ["decoder", "sharp-child-decoder"]) {
+			const source = await readFile(
+				new URL(`../../../../src/media/safe/${name}.ts`, import.meta.url),
+				"utf8",
+			);
+			await writeFile(
+				join(directory, `${name}.js`),
+				ts.transpileModule(source, {
+					compilerOptions: { module: ts.ModuleKind.ESNext, target: ts.ScriptTarget.ES2023 },
+				}).outputText,
+			);
+		}
+		await writeFile(join(directory, "package.json"), '{"type":"module"}');
+		const ready = join(directory, "ready");
+		const stub = join(directory, "sharp.mjs");
+		await writeFile(
+			stub,
+			`import { writeFileSync } from "node:fs";
+setTimeout(() => process.exit(1), 5000);
+const hang = () => { writeFileSync(${JSON.stringify(ready)}, "ready"); return new Promise(() => setInterval(() => {}, 1000)); };
+export default Object.assign(() => ({ metadata: hang, stats: hang }), { cache() {} });`,
+		);
+		const launcher = join(directory, "parent.mjs");
+		await writeFile(
+			launcher,
+			`import { createSharpChildDecoder } from "./sharp-child-decoder.js";
+const decoder = createSharpChildDecoder({ sharpPath: ${JSON.stringify(stub)}, onSpawn: (pid) => process.send(pid) });
+await decoder.decode(new Uint8Array([1]), ${JSON.stringify(request)});`,
+		);
+		parent = spawn(process.execPath, [launcher], { stdio: ["ignore", "ignore", "ignore", "ipc"] });
+		const closed = once(parent, "close");
+		[pid] = (await once(parent, "message", { signal: AbortSignal.timeout(2000) })) as [number];
+		await vi.waitFor(async () => expect(await readFile(ready, "utf8")).toBe("ready"), {
+			timeout: 2000,
+		});
+		parent.kill("SIGKILL");
+		await closed;
+		await vi.waitFor(() => expect(() => process.kill(pid!, 0)).toThrow(/ESRCH/), { timeout: 2000 });
+	} finally {
+		if (parent && parent.exitCode === null && parent.signalCode === null) {
+			const closed = once(parent, "close");
+			parent.kill("SIGKILL");
+			await closed;
+		}
+		await stop(pid);
+		await rm(directory, { recursive: true, force: true });
+	}
+});
