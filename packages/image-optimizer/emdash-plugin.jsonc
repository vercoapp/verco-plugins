{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

  "slug": "image-optimizer",
  "name": "Image optimizer",
  "publisher": "did:plc:x4pa534rsfytqfba2jrzs3zg", // verco.app

  "license": "MIT",
  "author": { "name": "Verco" },
  "security": { "email": "security@verco.app" },
  "repo": "https://github.com/vercoapp/verco-plugins",
  "description": "Finds images in the media library that could be smaller. Read-only for now: safe in-place optimization needs EmDash support.",
  "keywords": ["images", "media", "optimization", "performance", "report"],
  "sections": {
    "description": "The image report lists the images in your media library that are larger than your site needs, ordered by estimated saving, and shows on the dashboard how much could be saved. It reads only each image's type, size and dimensions, so every saving is an estimate.\n\n**Why it is read-only.** Optimizing an image means replacing its file. EmDash has no way yet for a plugin to replace a file safely: replacing overwrites the file at the same address, so the original is lost, a bad result cannot be undone, and an editor's change made at the same moment can be overwritten. Sandboxed plugins cannot replace files at all. Rather than work around that, the plugin reports and never changes media.\n\n**Optimizing is planned.** In-place optimization will be added once EmDash can replace an image while keeping its original and refusing conflicting changes. That support has been proposed to the EmDash project: https://github.com/emdash-cms/emdash/discussions/3740"
  },

  // Trust contract. The scan reads media metadata only (type, size, dimensions):
  // no bytes, no writes, no outbound network.
  "capabilities": ["media:read"],
  "allowedHosts": [],
  "storage": {
    // One scan result per media item, keyed by media ID.
    "results": { "indexes": ["runId", "status", ["status", "estimateBytes"]] },
  },

  "admin": {
    "pages": [{ "path": "/report", "label": "Image report", "icon": "image" }],
    "widgets": [{ "id": "savings", "title": "Image savings", "size": "third" }],
    "settingsSchema": {
      "maxDimension": {
        "type": "number",
        "label": "Largest useful edge (px)",
        "description": "Images wider or taller than this are reported as larger than the site needs.",
        "default": 2560,
        "min": 1,
      },
      "minSavingsKB": {
        "type": "number",
        "label": "Smallest saving to report (KB)",
        "default": 50,
        "min": 0,
      },
      "minSavingsPercent": {
        "type": "number",
        "label": "Smallest saving to report (% of the file)",
        "default": 20,
        "min": 0,
        "max": 100,
      },
    },
  },
}
