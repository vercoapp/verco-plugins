{
  "name": "image-optimizer",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only image optimization report for EmDash media libraries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercoapp/verco-plugins.git",
    "directory": "packages/image-optimizer"
  },
  "homepage": "https://github.com/vercoapp/verco-plugins/tree/main/packages/image-optimizer#readme",
  "bugs": "https://github.com/vercoapp/verco-plugins/issues",
  "type": "module",
  "main": "dist/native.mjs",
  "exports": {
    ".": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.mjs"
    },
    "./sandbox": "./dist/plugin.mjs",
    "./descriptor": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "emdash-plugin.jsonc"
  ],
  "scripts": {
    "validate": "emdash-plugin validate",
    "build": "emdash-plugin build && vite build -c vite.native.config.ts && tsc -p tsconfig.native.json && mv dist/types/native.d.ts dist/native.d.ts && rm -r dist/types",
    "dev": "emdash-plugin dev",
    "typecheck": "tsc --noEmit",
    "test": "emdash-plugin validate && vitest run",
    "bundle": "emdash-plugin bundle",
    "calibrate": "node --experimental-strip-types calibration/calibrate.mjs",
    "calibrate:fetch-kodak": "node calibration/fetch-kodak.mjs"
  },
  "peerDependencies": {
    "emdash": ">=1.1.0"
  },
  "devDependencies": {
    "@emdash-cms/blocks": "1.1.0",
    "@emdash-cms/plugin-cli": "0.13.2",
    "@emdash-cms/plugin-test": "0.2.7",
    "emdash": "1.1.0",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
